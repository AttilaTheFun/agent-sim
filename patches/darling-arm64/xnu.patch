diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/x86sim_inotify.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/x86sim_inotify.c
