diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sockextra.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sockextra.h
new file mode 100644
index 00000000..5b935227
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sockextra.h
@@ -0,0 +1,68 @@
+#ifndef NETWORK_SOCKEXTRA_H
+#define NETWORK_SOCKEXTRA_H
+// x86Sim: socket options and ioctls Network.framework asks for that Linux has no direct counterpart of, answered as
+// XNU does (see FINDINGS.md "Spike 3.10"): IP_OUT_IF/IPV6_OUT_IF, SO_CONNECTION_IDLE, TCP_NOTSENT_LOWAT, SIOCGCONNINFO.
+
+#define BSD_IP_OUT_IF 9696          // netinet/in_private.h (IPPROTO_IP), get only
+#define BSD_IPV6_OUT_IF 9696        // netinet6/in6_private.h (IPPROTO_IPV6), get only
+#define BSD_SO_CONNECTION_IDLE 0x1137 // sys/socket_private.h (SOL_SOCKET), int
+#define BSD_SO_DEFUNCTOK 0x1100     // sys/socket_private.h (SOL_SOCKET), int: may be defuncted (default 1)
+#define BSD_TCP_NOTSENT_LOWAT 0x201 // netinet/tcp.h
+#define LINUX_TCP_NOTSENT_LOWAT 25
+#define BSD_SIOCGCONNINFO 0xc0407398U // _IOWR('s', 152, struct so_cinforeq), 64 bytes on 64-bit
+
+// the interface index the socket's traffic leaves through (0 if none yet), as XNU's inp_last_outifp
+int sockextra_out_ifindex(int fd);
+// SO_CONNECTION_IDLE, kept per descriptor: 0 or a negative BSD errno
+long sockextra_set_idle(int fd, const void* optval, int optlen);
+long sockextra_get_idle(int fd, void* optval, int* optlen);
+// x86Sim: XNU's traffic class options (sys/socket.h): SO_TRAFFIC_CLASS (int: SO_TC_BE 0 ... SO_TC_CTL 900, or
+// SO_TC_NET_SERVICE_OFFSET + a network service type), SO_RECV_TRAFFIC_CLASS (int flag), SO_NET_SERVICE_TYPE (int,
+// NET_SERVICE_TYPE_BE 0 ... NET_SERVICE_TYPE_RD 8). Linux has no counterpart (SO_PRIORITY is not the same scale): kept
+// per descriptor, validated as XNU's sosetoptlock() does. nsurlsessiond puts every background session's socket in
+// SO_TC_BK; EINVAL there made Network.framework's nw_socket_add_input_handler fail the flow ("Failed to initialize
+// socket"): a background URLSession download never connected and timed out (-1001) forever.
+#define BSD_SO_TRAFFIC_CLASS 0x1086
+#define BSD_SO_RECV_TRAFFIC_CLASS 0x1087
+#define BSD_SO_NET_SERVICE_TYPE 0x1116
+long sockextra_set_tc(int fd, int optname, const void* optval, int optlen);
+// x86Sim: SO_RECV_ANYIF (sys/socket_private.h, int): XNU's "receive on any interface, even a restricted one"; there are
+// no restricted interfaces here: kept and read back. Its EINVAL failed every NSNetService listening socket
+// (tcp_listener_socket_create): MCNearbyServiceAdvertiser reported NSNetServicesErrorDomain 22 and advertised nothing.
+#define BSD_SO_RECV_ANYIF 0x1104
+// IP_RECVIF (netinet/in.h 20, int): each datagram's receiving interface as an IP_RECVIF control message holding a
+// struct sockaddr_dl. Linux's IP_PKTINFO carries the interface index: turned on underneath and converted in
+// recvmsg() (sockextra_recvif_cmsg). ENOTSUP failed Network.framework's multicast inbox (NWConnectionGroup).
+#define BSD_IP_RECVIF 20
+// IP_RECVDSTADDR (netinet/in.h 7, int): each datagram's destination address as an IP_RECVDSTADDR control message (a
+// struct in_addr), from IP_PKTINFO's ipi_addr the same way (Network.framework's multicast inbox asks for it too)
+#define BSD_IP_RECVDSTADDR_OPT 7
+long sockextra_set_flag(int fd, int level, int optname, const void* optval, int optlen);
+long sockextra_get_flag(int fd, int level, int optname, void* optval, int* optlen);
+// IP_PKTINFO as the program asked for it (so IP_RECVIF's own use of it stays invisible)
+void sockextra_note_pktinfo(int fd, int on);
+int sockextra_recvif(int fd);          // IP_RECVIF on
+int sockextra_recvdst(int fd);         // IP_RECVDSTADDR on
+int sockextra_pktinfo_user(int fd);    // IP_PKTINFO asked for by the program
+long sockextra_get_tc(int fd, int optname, void* optval, int* optlen);
+// forget a closed descriptor's state
+void sockextra_closed(int fd);
+// SIOCGIFFUNCTIONALTYPE (XNU's ifnet_functional_type()): ifr is a struct ifreq; returns 0 or a negative BSD errno
+#define BSD_SIOCGIFFUNCTIONALTYPE 0xc02069adU // _IOWR('i', 173, struct ifreq)
+long sockextra_functional_type(int fd, void* ifr);
+// x86Sim: XNU never blocks a send on a local datagram socket: a full receiver fails it with ENOBUFS (uipc_send()'s
+// sbappendaddr()), where Linux sleeps until there is room. launchd_sim's dispatch workers log (os_log_simple_send())
+// into launchd_sim's own CoreSimulator log socket; on a first boot they filled it, slept in sendto() with no worker
+// left to drain it (Darling has no workqueue to add threads), and launchd_sim stopped answering bootstrap check-ins:
+// every process hung in libxpc's initializer. 1 for an AF_UNIX SOCK_DGRAM socket: send it MSG_DONTWAIT, EAGAIN
+// becomes ENOBUFS (sendto.c, sendmsg.c).
+int sockextra_unix_dgram(int fd);
+// x86Sim: SIOCGIFFLAGS (Linux's, with its flags in Darwin's numbers as NET_RT_IFLIST gives them, ifinfo.c bsd_flags()):
+// 0 or a negative BSD errno. Network.framework's multicast listener (NWConnectionGroup) checks IFF_MULTICAST this way;
+// ENOTSUP made it log "Interface ... doesn't support multicast" and fail the group with EINVAL.
+long sockextra_ifflags(int fd, void* ifr);
+// SIOCGIFMTU (Linux SIOCGIFMTU on the same ifreq layout: name[16], int at +16): 0 or a negative BSD errno
+long sockextra_mtu(int fd, void* ifr);
+// SIOCGCONNINFO (XNU's in_getconninfo()/in6_getconninfo())
+long sockextra_conninfo(int fd, void* arg);
+#endif
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/socktables.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/socktables.h
new file mode 100644
index 00000000..f7855fd7
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/socktables.h
@@ -0,0 +1,69 @@
+#ifndef NETWORK_SOCKTABLES_H
+#define NETWORK_SOCKTABLES_H
+
+#include <darling/emulation/xnu_syscall/bsd/helper/network/route.h>
+#include <darling/emulation/xnu_syscall/bsd/helper/network/sostate.h>
+#include <darling/emulation/xnu_syscall/bsd/helper/network/nosigpipe.h>
+
+// The tables the network helpers keep, and the descriptor events they follow. Each is checked through its gate, so a
+// process without one pays a load.
+// - route.h: routing sockets, per descriptor number;
+// - sostate.h: held errors and EVFILT_SOCK's watches, per socket (its cookie): a copy of a descriptor needs nothing;
+// - nosigpipe.h: SO_NOSIGPIPE, per descriptor number.
+// libkqueue's own hooks (for-libkqueue.h's kqueue_closed_fd(), kqueue_dup()) are called beside these.
+
+// Descriptor fd is about to be closed (its socket is still there to be looked up).
+static inline void socket_tables_close(int fd)
+{
+	// before the number can be reused for another routing socket
+	if (ROUTE_SOCKET_ACTIVE())
+		route_socket_close(fd);
+	if (SOCKET_ENTRIES_USED())
+		socket_errors_close(fd);
+	if (NOSIGPIPE_ACTIVE())
+		socket_nosigpipe_close(fd);
+}
+
+// dup2() is about to replace descriptor fd: what socket_tables_replaced() needs to know of it, looked up before.
+static inline unsigned long long socket_tables_replacing(int fd)
+{
+	return SOCKET_ENTRIES_USED() ? socket_errors_cookie(fd) : 0;
+}
+
+// dup2() replaced descriptor fd, of which replacing is socket_tables_replacing()'s answer. Only once it has: a dup2()
+// that fails leaves fd as it was.
+static inline void socket_tables_replaced(int fd, unsigned long long replacing)
+{
+	if (ROUTE_SOCKET_ACTIVE())
+		route_socket_close(fd);
+	socket_errors_forget(replacing);
+	if (NOSIGPIPE_ACTIVE())
+		socket_nosigpipe_close(fd);
+}
+
+// Descriptor copy is now a copy of fd (dup, dup2, F_DUPFD).
+static inline void socket_tables_dup(int fd, int copy)
+{
+	if (ROUTE_SOCKET_ACTIVE())
+		route_socket_dup(fd, copy);
+	if (NOSIGPIPE_ACTIVE())
+		socket_nosigpipe_dup(fd, copy);
+}
+
+// In the child of a fork, before it runs anything else: a parent thread may have held the tables' locks, and a signal
+// handler (whose read() or write() takes them) may run as soon as the child checks in with darlingserver.
+static inline void socket_tables_atfork_child(void)
+{
+	route_atfork_child();
+	socket_errors_atfork_child();
+	socket_nosigpipe_atfork_child();
+}
+
+// A send on fd (write, writev, sendto, sendmsg) failed with ret (a negative BSD errno): XNU's sosendcheck() result
+// (sostate.h), then sendit()'s SIGPIPE (nosigpipe.h), in that order. msg_nosignal, linux_raised: socket_send_done()'s.
+static inline long socket_send_failed(int fd, long ret, int msg_nosignal, int linux_raised)
+{
+	return socket_send_done(fd, socket_error_send(fd, ret), msg_nosignal, linux_raised);
+}
+
+#endif // NETWORK_SOCKTABLES_H
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sockutil.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sockutil.h
new file mode 100644
index 00000000..fea30382
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sockutil.h
@@ -0,0 +1,40 @@
+#ifndef NETWORK_SOCKUTIL_H
+#define NETWORK_SOCKUTIL_H
+
+// Linux socket queries the network helpers share (route.c, sostate.c, nosigpipe.c). They return 0 or a negative
+// Linux errno.
+
+long linux_getsockopt(int fd, int level, int name, void* value, unsigned int* len);
+
+// Linux's SO_COOKIE (Linux 4.13): an identity for the socket fd refers to, never reused while the system runs. The
+// tables that remember something per socket key it by this, so a descriptor that was closed and its number reused
+// isn't taken for the old socket, and copies of a descriptor (dup, fork) are the same socket.
+long linux_socket_cookie(int fd, unsigned long long* cookie);
+
+// The start of Linux's struct tcp_info, up to tcpi_segs_in (Linux 4.2)
+struct linux_tcp_info {
+	unsigned char state;
+	unsigned char other[135];
+	unsigned int segs_out;
+	unsigned int segs_in;
+};
+
+// Linux's TCP states (include/net/tcp_states.h)
+enum {
+	LINUX_TCP_ESTABLISHED = 1,
+	LINUX_TCP_SYN_SENT,
+	LINUX_TCP_SYN_RECV,
+	LINUX_TCP_FIN_WAIT1,
+	LINUX_TCP_FIN_WAIT2,
+	LINUX_TCP_TIME_WAIT,
+	LINUX_TCP_CLOSE,
+	LINUX_TCP_CLOSE_WAIT,
+	LINUX_TCP_LAST_ACK,
+	LINUX_TCP_LISTEN,
+	LINUX_TCP_CLOSING,
+};
+
+// fd's TCP_INFO: 0 if fd is a TCP socket, a negative Linux errno if not.
+long linux_tcp_info(int fd, struct linux_tcp_info* info);
+
+#endif // NETWORK_SOCKUTIL_H
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sostate.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sostate.h
new file mode 100644
index 00000000..0ef46321
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/sostate.h
@@ -0,0 +1,114 @@
+#ifndef NETWORK_SOSTATE_H
+#define NETWORK_SOSTATE_H
+
+#include <sys/errno.h>
+
+#include <darling/emulation/linux_premigration/ext/for-libkqueue.h>
+
+// A socket's state as XNU keeps it in so_state and so_error (bsd/sys/socketvar.h), derived from the Linux socket, for
+// EVFILT_SOCK (libkqueue's src/linux/socket.c, which follows XNU's filt_sockev_common) and the socket filters' error
+// reports; and the socket error paths made XNU's.
+//
+// so_error needs care. XNU's EVFILT_SOCK reports a pending error (EV_EOF, with the error as data) without clearing
+// it, and the program then takes it. Linux has no way to look at a socket's error without clearing it. So for a TCP
+// socket Linux has closed, whose error is the reason (a reset, a refused connect, a timeout), the first look takes it
+// from Linux and holds it here until a consumer takes it, as XNU's would. The first look may be EVFILT_SOCK's, or
+// EVFILT_READ's or EVFILT_WRITE's at end of file (in any process using kqueue on sockets), or a failed send's. A
+// closed TCP socket stays hung up after that (POLLHUP), so poll, select, EVFILT_READ/WRITE and blocking calls still
+// find it at once. Other sockets' errors (a datagram socket's ICMP errors) stay in Linux, where blocking calls and
+// poll find them: EVFILT_SOCK doesn't report them, which XNU's would (its udp_notify() posts no hint, but
+// filt_sockev_common reports so_error).
+//
+// XNU's consumers of so_error, and what they become here:
+// - getsockopt(SO_ERROR) (sogetoptlock), which clears it: the held error if Linux has none of its own.
+// - soreceive() (read, readv, recvfrom, recvmsg): with no data, the error before end of file or EWOULDBLOCK, cleared
+//   unless MSG_PEEK. Linux returns its own errors there too; a TCP socket's EPIPE (Linux's error for a reset in
+//   CLOSE_WAIT) is XNU's ECONNRESET.
+// - sosendcheck() (write, writev, sendto, sendmsg): a disconnected socket fails with EPIPE first (SS_CANTSENDMORE),
+//   leaving so_error. Linux returns the error to the first send instead and clears it: on a closed TCP socket that
+//   becomes EPIPE, with the error held for the consumers above (nosigpipe.h raises SIGPIPE as XNU does).
+// - connect() on a socket whose nonblocking connect failed, and accept() on the listening socket: not hooked;
+//   Linux's own answers (the error, or ECONNABORTED) stand.
+//
+// A socket holds one error, the newest, as XNU's does: an error Linux returns on its own replaces the held one.
+//
+// A reset after the peer's FIN (in CLOSE_WAIT) is EPIPE in Linux (XNU's ECONNRESET). Linux's recv() returns end
+// of file before it, leaving it (taken at end of file here: always by recvfrom and recvmsg, by read and readv while
+// EVFILT_SOCK knotes exist), and its send() returns and clears it, as the EPIPE of a
+// socket shut down for sending. A watched socket tells the two apart: it remembers its shutdown(), and its state when
+// the watch began. On another socket, a send that gets there first loses the error: recv() then finds end of file,
+// and SO_ERROR none.
+//
+// EVFILT_SOCK's hints (NOTE_CONNRESET, NOTE_TIMEOUT) are XNU's TCP's, posted when the error happens; a knote may look
+// only after the program took the error. So while a knote watches a socket (_socket_watch_4libkqueue), the consumers
+// above count its errors by the hint they raise, and the knote raises a hint when the socket's count moved past the one it saw.
+//
+// The sockets remembered are those holding an error or watched by a knote: up to SOCKET_ENTRIES_MAX at once (by their
+// SO_COOKIE, sockutil.h, which needs Linux 4.13). Beyond that, the oldest is forgotten, one that is only watched
+// before one holding an error (whose error would be lost). Closing a descriptor forgets its socket's held error, also
+// for copies of the descriptor that stay open (dup), which then find none; the socket stays remembered while watched.
+//
+// Known limits, all from the table being the process's own (XNU's so_error belongs to the socket):
+// - fork: the child starts with a copy of the parent's held errors, so both can take the same one; it has no knotes;
+// - exec: the new image finds no held errors (Linux cleared them);
+// - a descriptor passed over SCM_RIGHTS arrives without its held error.
+//
+// Other known limits:
+// - a send takes a closed TCP socket's error from Linux before it can hold it: a recv() in between finds end of file
+//   (a knote that looked in between is woken to look again);
+// - a reset in LAST_ACK or CLOSING: XNU's tcp_input() closes the socket without an error, Linux sets ECONNRESET,
+//   which is reported (NOTE_CONNRESET, and the error);
+// - a shutdown() through another process's copy of a watched socket isn't remembered.
+
+#define SOCKET_ENTRIES_MAX 128
+
+// for-libkqueue.h's _socket_state_4libkqueue, _socket_error_4libkqueue and _socket_watch_4libkqueue
+int socket_state(int fd, struct socket_state_4libkqueue* state);
+int socket_error(int fd, int linux_error);
+void socket_watch(int fd, int delta);
+
+// Non-zero while there is something for the error paths below to do; each checks before calling.
+extern volatile int socket_errors_held;    // sockets holding an error
+extern volatile int socket_errors_taking;  // threads between taking an error from Linux and holding it
+extern volatile int socket_entries_used;   // sockets remembered (a held error, or watched)
+extern volatile int socket_watchers;       // EVFILT_SOCK knotes
+
+// taking first: a reader that finds no error in Linux and none taking finds the one taken held
+#define SOCKET_ERRORS_HELD() (__atomic_load_n(&socket_errors_taking, __ATOMIC_SEQ_CST) != 0 || \
+	__atomic_load_n(&socket_errors_held, __ATOMIC_SEQ_CST) != 0)
+
+// getsockopt(SO_ERROR) on fd got the BSD errno error (0 if none) from Linux, which cleared it there: returns the error
+// XNU's would, and clears the one held here.
+#define SOCKET_ERROR_OPT_HOOKED(error) (SOCKET_ERRORS_HELD() || ((error) != 0 && ((error) == EPIPE || socket_watchers != 0)))
+int socket_error_take(int fd, int error);
+
+// A read from fd (read, readv, recvfrom, recvmsg) returned ret (bytes, 0 at end of file, or a negative BSD errno),
+// and ret <= 0: returns what XNU's would. eof: look for a TCP socket's error at end of file (one system call), which
+// recvfrom and recvmsg always do, and read and readv while EVFILT_SOCK knotes exist (their end of file is mostly a
+// file's).
+#define SOCKET_READ_HOOKED(ret) (SOCKET_ERRORS_HELD() || ((ret) <= 0 && socket_watchers != 0))
+#define SOCKET_RECV_HOOKED(ret) ((ret) == 0 || SOCKET_READ_HOOKED(ret))
+long socket_error_read(int fd, long ret, int peek, int eof);
+
+// A send on socket fd (write, writev, sendto, sendmsg) failed with ret (a negative BSD errno): returns XNU's result.
+// Raises no signal (socktables.h's socket_send_failed() goes on to nosigpipe.h, which does).
+long socket_error_send(int fd, long ret);
+
+// Descriptor fd is about to be closed: socket_errors_close(). dup2() is about to replace it: socket_errors_cookie()
+// before, socket_errors_forget() once it did.
+#define SOCKET_ENTRIES_USED() (socket_entries_used != 0)
+void socket_errors_close(int fd);
+unsigned long long socket_errors_cookie(int fd); // 0 if fd isn't a socket
+void socket_errors_forget(unsigned long long cookie);
+
+// shutdown(fd, how) succeeded: a watched socket remembers it (Linux reports a stream socket's shutdown of only
+// sending no way, and a datagram socket's none). Called while socket_watchers != 0.
+void socket_shutdown(int fd, int how);
+
+// connect() or shutdown() on fd: tells its EVFILT_SOCK knotes (for-libkqueue.h's kqueue_socket_changed)
+#define SOCKET_CHANGED(fd) do { if (socket_watchers != 0) kqueue_socket_changed(fd); } while (0)
+
+// In the child of a fork, before it runs anything else.
+void socket_errors_atfork_child(void);
+
+#endif // NETWORK_SOSTATE_H
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/tcpinfo.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/tcpinfo.h
new file mode 100644
index 00000000..fd044b29
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/tcpinfo.h
@@ -0,0 +1,231 @@
+#ifndef NETWORK_TCPINFO_H
+#define NETWORK_TCPINFO_H
+
+#include <stdint.h>
+#include <sys/types.h>
+
+// getsockopt(IPPROTO_TCP, TCP_INFO) and (IPPROTO_TCP, TCP_CONNECTION_INFO), as XNU answers them (tcp_fill_info() and
+// tcp_connection_fill_info() in bsd/netinet/tcp_usrreq.c), from Linux's TCP_INFO. libnetwork asks for both of every
+// connection (nw_socket_copy_info). The values Linux has no counterpart for are 0; see tcpinfo.c.
