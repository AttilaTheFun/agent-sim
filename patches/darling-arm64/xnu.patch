+// kevent64 has no qos field, so remember each knote's qos (it decides
+// whether an event goes to the event manager thread) by (ident, filter, udata)
+struct wq_knote_qos
+{
+	uint64_t ident;
+	uint64_t udata;
+	int16_t filter;
+	bool used;
+	uint32_t qos;
+	// workloop the knote was registered on with kevent_id (0: the workq kqueue)
+	uint64_t workloop;
+	// x86Sim: its ident in the shared kqueue (wl_kq_ident: a workloop's timers get one of their own)
+	uint64_t kq_ident;
+};
+
+/*
+ * x86Sim (2026-11-13): on XNU every workloop is a kqueue of its own, so libdispatch gives the timers of each workloop
+ * and the event manager's the same ident (DISPATCH_TIMER_IDENT). Here all of them are knotes of the one workq
+ * kqueue, which has one knote per (ident, filter): re-arming the manager's timer took over the knote a workloop had
+ * just armed, and that workloop's timers never fired again until something else re-armed them. PineBoard's startup
+ * work then waited 25-30 s (the TV's "hot black" stayed up until the 30 s attention timeout) or for good (a boot
+ * stuck black). A timer's ident means nothing to the kernel: a workloop's timer gets its own in the shared kqueue,
+ * and its events go back to the workloop with the ident it registered (wq_qos_lookup).
+ */
+static uint64_t wl_kq_ident(uint64_t workloop, const struct kevent_qos_s* ch)
+{
+	if (workloop == 0 || ch->filter != EVFILT_TIMER)
+		return ch->ident;
+	return 0x7000000000000000ull | ((workloop << 8) & 0x0fffffffffffff00ull) | (ch->ident & 0xff);
+}
+static struct wq_knote_qos wq_qos_table[WQ_QOS_TABLE_SIZE];
+static libsimple_lock_t wq_qos_lock = LIBSIMPLE_LOCK_INITIALIZER;
+// x86Sim: set once a knote could not be recorded; from then on liveness is unknown
+static bool wq_qos_overflow;
+
+static struct wq_knote_qos* wq_qos_find_locked(uint64_t ident, int16_t filter, uint64_t udata)
+{
+	struct wq_knote_qos* by_ident = NULL;
+	int i;
+
+	for (i = 0; i < WQ_QOS_TABLE_SIZE; i++)
+	{
+		struct wq_knote_qos* e = &wq_qos_table[i];
+		if (!e->used || (e->ident != ident && e->kq_ident != ident) || e->filter != filter)
+			continue;
+		if (e->udata == udata)
+			return e;
+		by_ident = e;
+	}
+	return by_ident;
+}
+
+static void wq_qos_record(const struct kevent_qos_s* ch, uint64_t workloop)
+{
+	struct wq_knote_qos* e;
+	int i;
+
+	libsimple_lock_lock(&wq_qos_lock);
+	e = wq_qos_find_locked(ch->ident, ch->filter, ch->udata);
+	if (e != NULL && e->udata != ch->udata)
+		e = NULL;
+
+	if (ch->flags & EV_DELETE)
+	{
+		// x86Sim: see wq_apply_changes: only called once the delete took effect
+		if (e != NULL)
+			e->used = false;
+	}
+	else if (ch->flags & EV_ADD)
+	{
+		if (e == NULL)
+		{
+			for (i = 0; i < WQ_QOS_TABLE_SIZE && wq_qos_table[i].used; i++);
+			if (i < WQ_QOS_TABLE_SIZE)
+				e = &wq_qos_table[i];
+			else
+			{
+				__simple_printf("kevent workq: qos table full\n");
+				wq_qos_overflow = true;
+			}
+		}
+		if (e != NULL)
+		{
+			e->ident = ch->ident;
+			e->kq_ident = wl_kq_ident(workloop, ch);
+			e->filter = ch->filter;
+			e->udata = ch->udata;
+			e->qos = ch->qos;
+			if (!e->used || workloop != 0)
+				e->workloop = workloop;
+			e->used = true;
+		}
+	}
+	else if (e != NULL && ch->qos != 0)
+		e->qos = ch->qos;
+	libsimple_lock_unlock(&wq_qos_lock);
+}
+
+/*
+ * x86Sim: is the knote an event was copied out for still registered? The manager thread
+ * copies events out of libkqueue (for Mach ports that is when darlingserver hands over the
+ * message, or a fake EV_VANISHED once the receive right is destroyed) and only then queues
+ * them for a servicer. A knote deleted in between must not get the event: XNU drops a
+ * deleted knote's activation with it. Delivered anyway, libdispatch merged it into a freed
+ * unote ("API MISUSE: Resurrection of an object", backboardd) or into a mach channel it had
+ * disconnected and whose port it had destroyed ("Unexpected EV_VANISHED", Spotlight): libxpc
+ * cancels a connection (EV_DELETE succeeds), destroys the port, darlingserver reports it
+ * vanished to the still-open kqchan, the manager reads that before the close is seen...
+ * Called with wq_qos_lock held.
+ */
+static bool wq_knote_live_locked(const struct kevent_qos_s* ev)
+{
+	struct wq_knote_qos* e;
+
+	if (wq_qos_overflow)
+		return true;
+	e = wq_qos_find_locked(ev->ident, ev->filter, ev->udata);
+	if (e == NULL)
+		return false;
+	return !(ev->flags & EV_UDATA_SPECIFIC) || e->udata == ev->udata;
+}
+
+static bool wq_knote_live(const struct kevent_qos_s* ev)
+{
+	bool live;
+	libsimple_lock_lock(&wq_qos_lock);
+	live = wq_knote_live_locked(ev);
+	libsimple_lock_unlock(&wq_qos_lock);
+	return live;
+}
+
+static uint32_t wq_qos_lookup(struct kevent_qos_s* ev, uint64_t* workloop)
+{
+	struct wq_knote_qos* e;
+	uint32_t qos = 0;
+
+	*workloop = 0;
+	libsimple_lock_lock(&wq_qos_lock);
+	e = wq_qos_find_locked(ev->ident, ev->filter, ev->udata);
+	if (e != NULL)
+	{
+		qos = e->qos;
+		*workloop = e->workloop;
+		ev->ident = e->ident; // x86Sim: as registered (wl_kq_ident)
+	}
+	libsimple_lock_unlock(&wq_qos_lock);
+	return qos;
+}
