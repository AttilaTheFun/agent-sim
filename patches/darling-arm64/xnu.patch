diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/ifinfo.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/ifinfo.h
new file mode 100644
index 00000000..1d84c3d8
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/ifinfo.h
@@ -0,0 +1,41 @@
+#ifndef NETWORK_IFINFO_H
+#define NETWORK_IFINFO_H
+
+// Linux's interfaces as Darwin describes them: one numbering (Linux's own interface index, which PF_ROUTE's RTM_GET,
+// NET_RT_IFLIST and so getifaddrs(), if_nametoindex() and if_indextoname() all report) and one enumeration (every link
+// rtnetlink lists, with all its IPv4 and IPv6 addresses).
+//
+// Darwin's indexes are 16 bits (ifm_index, sdl_index, rtm_index): an interface whose Linux index is larger can't be
+// named, so it isn't listed, and RTM_GET finds no route through it.
+
+#define IFINFO_MAX_INDEX 0xffff
+
+struct ifinfo {
+	int index;
+	unsigned short arphrd;    // Linux's link type (ARPHRD_*)
+	unsigned int flags;       // Linux's IFF_*
+	unsigned int mtu;
+	unsigned int txqlen;      // IFLA_TXQLEN: the send queue's length limit
+	char name[16];
+	int name_len;
+	unsigned char lladdr[32];
+	int lladdr_len;
+	unsigned long long ipackets, opackets, ibytes, obytes, ierrors, oerrors, iqdrops, odrops, imcasts, collisions;
+};
+
+// The interface Linux numbers index, over the rtnetlink socket nl. Returns 0 or a negative BSD errno.
+int ifinfo_get(int nl, int index, struct ifinfo* info);
+
+// Its sockaddr_dl, as RTA_IFP and NET_RT_IFLIST carry it: name, type and link-layer address. Returns its length, or
+// -ENOBUFS if size is too small.
+struct sockaddr_dl;
+int ifinfo_link_sockaddr(const struct ifinfo* info, struct sockaddr_dl* sdl, unsigned long size);
+
+// NET_RT_IFLIST (XNU's sysctl_iflist()): for each interface (only index's, if not 0), an RTM_IFINFO message, then an
+// RTM_NEWADDR for each of its addresses (only family af's, if not 0). With old NULL, *oldlen is set to the size
+// needed; otherwise the messages that fit go into old and *oldlen is set to their size (-ENOMEM if not all fit).
+// With iflist2, NET_RT_IFLIST2 (sysctl_iflist2()): the same, with RTM_IFINFO2 (if_msghdr2, 64-bit if_data64
+// counters) for each interface.
+int ifinfo_iflist(int af, int index, int iflist2, void* old, unsigned long* oldlen);
+
+#endif // NETWORK_IFINFO_H
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/nosigpipe.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/nosigpipe.h
index 9e3b9f36..7c174ade 100644
--- a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/nosigpipe.h
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/nosigpipe.h
@@ -1,31 +1,51 @@
-#ifndef DARLING_EMULATION_NOSIGPIPE_H
-#define DARLING_EMULATION_NOSIGPIPE_H
-
-// Darwin's per-socket SO_NOSIGPIPE option: a write to a socket whose peer has
-// gone fails with EPIPE without raising SIGPIPE. Linux only has MSG_NOSIGNAL
-// per call, so the option is kept here, per descriptor, and the write paths
-// ask for MSG_NOSIGNAL while it is set.
-
-// Returns 1 if SO_NOSIGPIPE is set on the socket behind fd, else 0.
-int nosigpipe_get(int fd);
-
-// Sets or clears the option. Returns 0, or a negative Darwin errno if fd
-// cannot be tracked.
-long nosigpipe_set(int fd, int on);
-
-// Descriptor bookkeeping: close (called before the descriptor is closed) and
-// dup/dup2/F_DUPFD (called after newfd was created; newfd shares oldfd's
-// open file and so its option). Until the call returns, a thread that uses
-// newfd already sees the option as it was left by the previous owner of the
-// number.
-void nosigpipe_close(int fd);
-void nosigpipe_dup(int oldfd, int newfd);
-
-// A socket was just created at fd (socket, socketpair): forget whatever an
-// earlier owner of the number left behind. A descriptor can be closed behind
-// this module's back (by a forked child's guard table, or by the host under
-// FEX), so close() is not enough. accept() uses nosigpipe_dup() from the
-// listener instead, as the accepted socket inherits the option.
-void nosigpipe_created(int fd);
-
-#endif // DARLING_EMULATION_NOSIGPIPE_H
+#ifndef NETWORK_NOSIGPIPE_H
+#define NETWORK_NOSIGPIPE_H
+
+// SIGPIPE as XNU raises it: a send that fails with EPIPE (write, writev, sendto, sendmsg) raises SIGPIPE unless the
+// socket has SO_NOSIGPIPE set or the send asked for MSG_NOSIGNAL (bsd/kern/uipc_syscalls.c sendit(),
+// sys_socket.c soo_write()). Linux has no per-socket switch: it raises SIGPIPE for every EPIPE without MSG_NOSIGNAL.
+// Apple's networking code sets SO_NOSIGPIPE on its sockets and relies on it (Network.framework's connections die of
+// SIGPIPE otherwise when the peer goes away).
+//
+// sendto and sendmsg always send with Linux's MSG_NOSIGNAL and raise SIGPIPE here as XNU would. write and writev on a
+// socket with SO_NOSIGPIPE send through sendmsg with MSG_NOSIGNAL; other descriptors write as before (Linux raising
+// SIGPIPE itself). That needs knowing which descriptors are such sockets on every write, without a system call: the
+// flag is kept per descriptor number, with the socket's cookie (sockutil.h), set by setsockopt, copied by dup(),
+// dup2() and F_DUPFD, and cleared by close() and dup2() over it. A copy of the descriptor made some other way
+// (received over SCM_RIGHTS, inherited across exec) doesn't have it, and neither do descriptors numbered
+// NOSIGPIPE_FDS_MAX or above (whose SO_NOSIGPIPE is ignored). sendto and sendmsg also find the flag set
+// through another descriptor for the same socket, and teach it to that descriptor.
+
+#define NOSIGPIPE_FDS_MAX (1 << 20)
+
+// Non-zero while a descriptor has SO_NOSIGPIPE: the write paths check it before looking theirs up.
+extern volatile int nosigpipe_fds;
+
+#define NOSIGPIPE_ACTIVE() (nosigpipe_fds != 0)
+
+// setsockopt/getsockopt(SOL_SOCKET, SO_NOSIGPIPE) on fd: 0 or a negative BSD errno.
+long socket_nosigpipe_set(int fd, int on);
+long socket_nosigpipe_get(int fd, int* on);
+
+// write/writev on fd: if fd is a socket with SO_NOSIGPIPE, sends iov through sendmsg with MSG_NOSIGNAL, stores the
+// result (bytes, or a negative BSD errno) in *result and returns 1. Returns 0 for other descriptors.
+struct iovec;
+int socket_nosigpipe_write(int fd, const struct iovec* iov, int iovcnt, long* result);
+
+// A send on fd returned ret (bytes, or a negative BSD errno) after the socket error paths (sostate.h). If it's EPIPE
+// and neither the send (msg_nosignal: BSD MSG_NOSIGNAL) nor the socket asked for none, raises SIGPIPE,
+// unless Linux did already (linux_raised: the call went to Linux without MSG_NOSIGNAL and Linux returned EPIPE).
+// As XNU's psignal() does, it goes to the process, where a thread not blocking it takes it. (Linux's own SIGPIPE,
+// for the write() of a descriptor without SO_NOSIGPIPE, goes to the sending thread.)
+long socket_send_done(int fd, long ret, int msg_nosignal, int linux_raised);
+
+// The descriptor fd is being closed, or dup2() is about to replace it.
+void socket_nosigpipe_close(int fd);
+
+// copy is now a copy of the descriptor fd (dup, dup2, F_DUPFD).
+void socket_nosigpipe_dup(int fd, int copy);
+
+// In the child of a fork, before it runs anything else.
+void socket_nosigpipe_atfork_child(void);
+
+#endif // NETWORK_NOSIGPIPE_H
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/route.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/route.h
new file mode 100644
index 00000000..b125195c
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/route.h
@@ -0,0 +1,68 @@
+#ifndef NETWORK_ROUTE_H
+#define NETWORK_ROUTE_H
+
+// PF_ROUTE sockets (XNU's bsd/net/rtsock.c), as far as a process asks the kernel which route and interface an address
+// goes out on: RTM_GET (and RTM_GET_SILENT). The iOS Simulator's Network.framework evaluates every nw_path that way
+// (on a Mac it asks the host kernel); without it each path is "unsatisfied (No network route)".
+//
+// A routing socket is one end of a Linux AF_UNIX datagram socketpair. Writing a message to it (write, writev, sendto,
+// sendmsg) is answered here, from Linux's routing table over NETLINK_ROUTE, and the reply is queued on the other end
+// (the answering end), so reading it, polling it, kqueue and FIONBIO behave as on a socket.
+//
+// Design:
+// - The answer is built in the writer's thread, before write() returns, because XNU's route_output() queues the
+//   reply before returning and Network.framework reads right after, with FIONBIO set: a background responder would
+//   hand it EAGAIN.
+// - The answer describes the routing table entry that matched (Linux's RTM_F_FIB_MATCH): its prefix, mask and
+//   origin, with the interface, gateway and source address Linux would use. The unspecified address (0.0.0.0, ::)
+//   matches the default route, as in XNU's radix tree.
+// - Messages other than RTM_GET fail with EPERM (the routes are Linux's), and no unsolicited messages (RTM_IFINFO,
+//   RTM_NEWADDR...) are ever sent; a reply goes only to its sender, never to other routing sockets. If broadcasts are
+//   ever needed, darlingserver is their home: one rtnetlink subscription, fanned out to every process's sockets.
+// - The answering end is per process (a forked child shares it), and a guarded descriptor, as darlingserver's are: the
+//   program can't close it or dup2() over it. Copies of a routing socket made by dup(), dup2() and F_DUPFD are
+//   answered too; one inherited across exec() isn't (its answering end closed with the old image).
+// - Socket options: SO_TYPE is SOCK_RAW and SO_USELOOPBACK works (off: the sender gets no replies); options of any
+//   other level fail with ENOPROTOOPT, as the routing domain has none; the rest are the AF_UNIX socket's.
+// - The interfaces RTM_GET names are the ones NET_RT_IFLIST lists (ifinfo.h).
+
+long route_socket_create(int type, int protocol);
+
+// route_socket_count is non-zero while the process has a routing socket open: the write paths check it before
+// looking a descriptor up. The lookup takes no lock, so other descriptors' writes and closes never wait on one.
+extern volatile int route_socket_count;
+
+#define ROUTE_SOCKET_ACTIVE() (route_socket_count != 0)
+
+// If fd is a routing socket, handles the message in buf (len bytes) and stores the write's result in *result
+// (bytes written, or a negative BSD errno); returns 1. Returns 0 for any other descriptor. addressed: the caller gave
+// a destination address (sendto, sendmsg), which a routing socket refuses with EISCONN.
+int route_socket_write(int fd, const void* buf, unsigned long len, int addressed, long* result);
+
+// The iovec flavour, for writev and sendmsg; an iovcnt out of 1...UIO_MAXIOV fails with count_errno (writev's
+// EINVAL, sendmsg's EMSGSIZE).
+struct iovec;
+int route_socket_writev(int fd, const struct iovec* iov, int iovcnt, int addressed, int count_errno, long* result);
+
+// getsockopt (set 0) and setsockopt (set 1): returns 1 with the result in *result if fd is a routing socket and the
+// option is one handled here, 0 to leave it to Linux.
+int route_socket_sockopt(int fd, int set, int level, int name, void* value, int* value_len, long* result);
+
+// getsockname (peer 0) and getpeername (peer 1): returns 1 with the result in *result if fd is a routing socket.
+int route_socket_name(int fd, int peer, void* addr, int* addr_len, long* result);
+
+// The descriptor fd is being closed, or dup2() is about to replace it.
+void route_socket_close(int fd);
+
+// copy is now a copy of the descriptor fd (dup, dup2, F_DUPFD).
+void route_socket_dup(int fd, int copy);
+
+// In the child of a fork, before it runs anything else.
+void route_atfork_child(void);
+
+// x86Sim: NET_RT_DUMP (XNU's sysctl_rtsock() / sysctl_dumpentry()): an RTM_GET message for each route of family af (0:
+// IPv4 and IPv6) in Linux's main table. With old NULL, *oldlen is set to the size needed; otherwise the messages that
+// fit go into old and *oldlen is set to their size (-ENOMEM if not all fit).
+long route_dump(int af, void* old, unsigned long* oldlen);
+
+#endif // NETWORK_ROUTE_H
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/rtnetlink.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/rtnetlink.h
new file mode 100644
index 00000000..5806c334
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/network/rtnetlink.h
@@ -0,0 +1,134 @@
+#ifndef NETWORK_RTNETLINK_H
+#define NETWORK_RTNETLINK_H
+
+// Asking Linux about its interfaces, addresses and routes over NETLINK_ROUTE (linux/netlink.h, linux/rtnetlink.h,
+// linux/if_link.h, linux/if_addr.h), for the BSD views of them: PF_ROUTE's RTM_GET (route.c) and NET_RT_IFLIST
+// (ifinfo.c).
+
+#define LINUX_AF_UNSPEC 0
+#define LINUX_AF_INET 2
+#define LINUX_AF_INET6 10
+#define LINUX_AF_NETLINK 16
+
+#define LINUX_NLMSG_ERROR 2
+#define LINUX_NLMSG_DONE 3
+#define LINUX_NLM_F_REQUEST 0x1
+#define LINUX_NLM_F_MULTI 0x2
+#define LINUX_NLM_F_DUMP 0x300
+
+#define LINUX_RTM_NEWLINK 16
+#define LINUX_RTM_GETLINK 18
+#define LINUX_RTM_NEWADDR 20
+#define LINUX_RTM_GETADDR 22
+#define LINUX_RTM_NEWROUTE 24
+#define LINUX_RTM_GETROUTE 26
+
+#define LINUX_RTM_F_FIB_MATCH 0x2000
+
+#define LINUX_RTA_DST 1
+#define LINUX_RTA_OIF 4
+#define LINUX_RTA_GATEWAY 5
+#define LINUX_RTA_PRIORITY 6
+#define LINUX_RTA_PREFSRC 7
+#define LINUX_RTA_MULTIPATH 9
+#define LINUX_RTA_TABLE 15
+
+#define LINUX_RTN_UNICAST 1
