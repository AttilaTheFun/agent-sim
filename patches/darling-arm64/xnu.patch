+#define LINUX_MSG_TRUNC 0x20
+
+struct linux_sockaddr_nl {
+	unsigned short nl_family;
+	unsigned short nl_pad;
+	unsigned int nl_pid;
+	unsigned int nl_groups;
+};
+
+int rtnl_open(void)
+{
+	long nl;
+#ifdef __NR_socketcall
+	nl = LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_SOCKET,
+			((long[6]) { LINUX_AF_NETLINK, LINUX_SOCK_RAW | LINUX_SOCK_CLOEXEC, LINUX_NETLINK_ROUTE }));
+#else
+	nl = LINUX_SYSCALL(__NR_socket, LINUX_AF_NETLINK, LINUX_SOCK_RAW | LINUX_SOCK_CLOEXEC, LINUX_NETLINK_ROUTE);
+#endif
+	return nl < 0 ? errno_linux_to_bsd(nl) : nl;
+}
+
+void rtnl_close(int nl)
+{
+	LINUX_SYSCALL1(__NR_close, nl);
+}
+
+static long rtnl_send(int nl, const void* buf, unsigned long len)
+{
+	struct linux_sockaddr_nl kernel = { .nl_family = LINUX_AF_NETLINK };
+#ifdef __NR_socketcall
+	return LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_SENDTO, ((long[6]) { nl, buf, len, 0, &kernel, sizeof(kernel) }));
+#else
+	return LINUX_SYSCALL(__NR_sendto, nl, buf, len, 0, &kernel, sizeof(kernel));
+#endif
+}
+
+static long rtnl_recv(int nl, void* buf, unsigned long len)
+{
+	long ret;
+	do {
+#ifdef __NR_socketcall
+		ret = LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_RECVFROM, ((long[6]) { nl, buf, len, 0, 0, 0 }));
+#else
+		ret = LINUX_SYSCALL(__NR_recvfrom, nl, buf, len, 0, 0, 0);
+#endif
+	} while (ret == -LINUX_EINTR); // a signal doesn't fail the caller's write() or sysctl()
+	return ret;
+}
+
+int rtnl_talk(int nl, struct linux_nlmsghdr* req, rtnl_reply_f each, void* context)
+{
+	// a dump comes in datagrams of at most the largest read the socket has seen, and at least NLMSG_GOODSIZE (a page)
+	union {
+		struct linux_nlmsghdr h;
+		unsigned char bytes[8192];
+	} buf;
+	static unsigned int seq; // only tells this request's replies from a stale one's
+	long ret;
+
+	req->nlmsg_seq = __atomic_add_fetch(&seq, 1, __ATOMIC_RELAXED);
+	ret = rtnl_send(nl, req, req->nlmsg_len);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	for (;;) {
+		ret = rtnl_recv(nl, &buf, sizeof(buf));
+		if (ret < 0)
+			return errno_linux_to_bsd(ret);
+
+		unsigned long off = 0;
+		while (off + sizeof(struct linux_nlmsghdr) <= (unsigned long) ret) {
+			const struct linux_nlmsghdr* msg = (const void*) (buf.bytes + off);
+			if (msg->nlmsg_len < sizeof(*msg) || off + msg->nlmsg_len > (unsigned long) ret)
+				return -EIO;
+			off += RTNL_ALIGN(msg->nlmsg_len);
+			if (msg->nlmsg_seq != req->nlmsg_seq)
+				continue;
+			if (msg->nlmsg_type == LINUX_NLMSG_DONE)
+				return 0;
+			if (msg->nlmsg_type == LINUX_NLMSG_ERROR) {
+				const int* error = (const void*) (msg + 1);
+				if (msg->nlmsg_len < sizeof(*msg) + sizeof(*error))
+					return -EIO;
+				// 0 acknowledges a request that has no other reply
+				return *error ? errno_linux_to_bsd(*error) : 0;
+			}
+			int stop = each(msg, context);
+			if (stop)
+				return stop;
+			if (!(msg->nlmsg_flags & LINUX_NLM_F_MULTI))
+				return 0;
+		}
+	}
+}
+
+void rtnl_attrs(const struct linux_nlmsghdr* msg, unsigned long fixed_len, rtnl_attr_f each_attr, void* context)
+{
+	unsigned long off = sizeof(*msg) + RTNL_ALIGN(fixed_len);
+
+	while (off + sizeof(struct linux_rtattr) <= msg->nlmsg_len) {
+		const struct linux_rtattr* attr = (const void*) ((const unsigned char*) msg + off);
+		if (attr->rta_len < sizeof(*attr) || off + attr->rta_len > msg->nlmsg_len)
+			break;
+		each_attr(attr, attr + 1, attr->rta_len - (int) sizeof(*attr), context);
+		off += RTNL_ALIGN(attr->rta_len);
+	}
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sockextra.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sockextra.c
new file mode 100644
index 00000000..1bb525d5
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sockextra.c
@@ -0,0 +1,489 @@
+// x86Sim: see sockextra.h
+#include <darling/emulation/xnu_syscall/bsd/helper/network/sockextra.h>
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/errno.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/conversion/errno.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <darling/emulation/xnu_syscall/bsd/helper/network/tcpinfo.h>
+#include <darling/emulation/xnu_syscall/bsd/impl/network/getsockname.h>
+#include <darling/emulation/xnu_syscall/bsd/impl/network/getpeername.h>
+
+extern void* memset(void* dest, int c, __SIZE_TYPE__ n);
+extern int memcmp(const void* a, const void* b, __SIZE_TYPE__ n);
+
+#define L_AF_INET 2
+#define L_AF_INET6 10
+#define L_SOL_SOCKET 1
+#define L_SO_ERROR 4
+#define L_SO_DOMAIN 39
+#define L_SO_BINDTOIFINDEX 62
+#define L_SIOCGIFCONF 0x8912
+#define L_SIOCGIFINDEX 0x8933
+
+static long l_getsockopt(int fd, int level, int name, void* val, unsigned int* len)
+{
+#ifdef __NR_socketcall
+	return LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_GETSOCKOPT, ((long[6]) { fd, level, name, val, len, 0 }));
+#else
+	return LINUX_SYSCALL(__NR_getsockopt, fd, level, name, val, len);
+#endif
+}
+
+static long l_name(int fd, int peer, void* sa, unsigned int* len)
+{
+#ifdef __NR_socketcall
+	return LINUX_SYSCALL(__NR_socketcall, peer ? LINUX_SYS_GETPEERNAME : LINUX_SYS_GETSOCKNAME, ((long[6]) { fd, sa, len }));
+#else
+	return LINUX_SYSCALL(peer ? __NR_getpeername : __NR_getsockname, fd, sa, len);
+#endif
+}
+
+static int l_domain(int fd)
+{
+	int d = 0;
+	unsigned int len = sizeof(d);
+	return l_getsockopt(fd, L_SOL_SOCKET, L_SO_DOMAIN, &d, &len) < 0 ? -1 : d;
+}
+
+int sockextra_unix_dgram(int fd)
+{
+	int t = 0;
+	unsigned int len = sizeof(t);
+	if (l_getsockopt(fd, L_SOL_SOCKET, 3 /* SO_TYPE */, &t, &len) < 0 || t != 2 /* SOCK_DGRAM */)
+		return 0;
+	return l_domain(fd) == 1 /* AF_UNIX */;
+}
+
+struct l_ifreq { char name[16]; union { struct { uint16_t family, port; uint32_t addr; } in; int index; char pad[24]; }; };
+struct l_ifconf { int len; int pad; void* buf; };
+
+static int hexval(char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; }
+
+int sockextra_out_ifindex(int fd)
+{
+	int bound = 0;
+	unsigned int len = sizeof(bound);
+	if (l_getsockopt(fd, L_SOL_SOCKET, L_SO_BINDTOIFINDEX, &bound, &len) >= 0 && bound > 0)
+		return bound;
+
+	unsigned char sa[128];
+	len = sizeof(sa);
+	if (l_name(fd, 0, sa, &len) < 0)
+		return 0;
+	uint16_t family = *(uint16_t*) sa;
+
+	if (family == L_AF_INET) {
+		uint32_t addr = *(uint32_t*) (sa + 4);
+		if (addr == 0)
+			return 0; // not bound: no traffic yet
+		struct l_ifreq reqs[32];
+		struct l_ifconf conf = { sizeof(reqs), 0, reqs };
+		int s = fd;
+		if (LINUX_SYSCALL(__NR_ioctl, s, L_SIOCGIFCONF, &conf) < 0)
+			return 0;
+		for (int i = 0; i < conf.len / (int) sizeof(struct l_ifreq); i++) {
+			if (reqs[i].in.family == L_AF_INET && reqs[i].in.addr == addr) {
+				struct l_ifreq q;
+				memset(&q, 0, sizeof(q));
+				for (int k = 0; k < 16; k++) q.name[k] = reqs[i].name[k];
+				if (LINUX_SYSCALL(__NR_ioctl, s, L_SIOCGIFINDEX, &q) < 0)
+					return 0;
+				return q.index;
+			}
+		}
+		return 0;
+	}
+	if (family == L_AF_INET6) {
+		const unsigned char* a6 = sa + 8;
+		static const unsigned char zero[16];
+		if (!memcmp(a6, zero, 16))
+			return 0;
+		// IPv4-mapped: the IPv4 interface is not in if_inet6; leave it to the caller (0)
+		// /proc/net/if_inet6: "<32 hex addr> <ifindex hex> <plen> <scope> <flags> <name>"
+		int f = LINUX_SYSCALL(__NR_openat, -100, "/proc/net/if_inet6", 0, 0);
+		if (f < 0)
+			return 0;
+		static char buf[8192];
+		long n = LINUX_SYSCALL(__NR_read, f, buf, sizeof(buf) - 1);
+		LINUX_SYSCALL(__NR_close, f);
+		if (n <= 0)
+			return 0;
+		buf[n] = 0;
+		for (char* line = buf; *line; ) {
+			unsigned char addr[16];
+			int ok = 1;
+			for (int k = 0; k < 16; k++) {
+				int h = hexval(line[2 * k]), l = hexval(line[2 * k + 1]);
+				if (h < 0 || l < 0) { ok = 0; break; }
+				addr[k] = (unsigned char) (h * 16 + l);
+			}
+			if (ok && !memcmp(addr, a6, 16)) {
+				int idx = 0;
+				char* p = line + 33;
+				while (hexval(*p) >= 0) idx = idx * 16 + hexval(*p++);
+				return idx;
+			}
+			while (*line && *line != '\n') line++;
+			if (*line) line++;
+		}
+	}
+	return 0;
+}
+
+// XNU keeps the flag in the inpcb (INP2_CONNECTION_IDLE); here per descriptor, cleared when it is closed
+#define IDLE_FDS 8192
+static unsigned char idle_flags[IDLE_FDS / 8];
+
+long sockextra_set_idle(int fd, const void* optval, int optlen)
+{
+	int d = l_domain(fd);
+	if (d < 0)
+		return -ENOTSOCK;
+	if (d != L_AF_INET && d != L_AF_INET6)
+		return -EINVAL;
+	if (optval == NULL || optlen < (int) sizeof(int))
+		return -EINVAL;
+	if (fd >= 0 && fd < IDLE_FDS) {
+		if (*(const int*) optval)
+			idle_flags[fd / 8] |= (unsigned char) (1 << (fd % 8));
+		else
+			idle_flags[fd / 8] &= (unsigned char) ~(1 << (fd % 8));
+	}
+	return 0;
+}
+
+long sockextra_get_idle(int fd, void* optval, int* optlen)
+{
+	int d = l_domain(fd);
+	if (d < 0)
+		return -ENOTSOCK;
+	if (d != L_AF_INET && d != L_AF_INET6)
+		return -EINVAL;
+	if (optlen == NULL)
+		return -EFAULT;
+	int v = (fd >= 0 && fd < IDLE_FDS) ? !!(idle_flags[fd / 8] & (1 << (fd % 8))) : 0;
+	if (optval == NULL) { *optlen = 0; return 0; }
+	int n = *optlen < (int) sizeof(v) ? *optlen : (int) sizeof(v);
+	if (n < 0)
+		return -EINVAL;
+	for (int i = 0; i < n; i++) ((char*) optval)[i] = ((char*) &v)[i];
+	*optlen = n;
+	return 0;
+}
+
+// traffic class state per descriptor: the class (SO_TC_*, 0 = SO_TC_BE, XNU's default), the network service type it
+// came from (-1: none, SO_NET_SERVICE_TYPE reads NET_SERVICE_TYPE_BE then) and the SO_RECV_TRAFFIC_CLASS flag
+#define SO_TC_NET_SERVICE_OFFSET 10000
+#define NET_SERVICE_TYPE_RD 8
+static short tc_class[IDLE_FDS];
+static signed char tc_svc[IDLE_FDS];
+static unsigned char tc_recv[IDLE_FDS / 8];
+static unsigned char tc_svc_set[IDLE_FDS / 8];
+// XNU's sotc_by_netservicetype[] (uipc_socket.c): NET_SERVICE_TYPE_BE..RD -> SO_TC_*
+static const short tc_by_svc[NET_SERVICE_TYPE_RD + 1] = { 0, 200, 600, 700, 700, 800, 500, 400, 300 };
+
+static int tc_sock(int fd)
+{
+	int d = l_domain(fd);
+	return d < 0 ? -ENOTSOCK : 0;
+}
+
+long sockextra_set_tc(int fd, int optname, const void* optval, int optlen)
+{
+	int r = tc_sock(fd);
+	if (r < 0)
+		return r;
+	if (optval == NULL || optlen < (int) sizeof(int))
+		return -EINVAL;
+	int v = *(const int*) optval;
+	if (fd < 0 || fd >= IDLE_FDS)
+		return 0;
+	if (optname == BSD_SO_RECV_TRAFFIC_CLASS) {
+		if (v) tc_recv[fd / 8] |= (unsigned char) (1 << (fd % 8));
+		else tc_recv[fd / 8] &= (unsigned char) ~(1 << (fd % 8));
+		return 0;
+	}
+	int svc = -1;
+	if (optname == BSD_SO_NET_SERVICE_TYPE)
+		svc = v;
+	else if (v >= SO_TC_NET_SERVICE_OFFSET)
+		svc = v - SO_TC_NET_SERVICE_OFFSET;
+	if (svc >= 0 || optname == BSD_SO_NET_SERVICE_TYPE) {
+		if (svc < 0 || svc > NET_SERVICE_TYPE_RD)
+			return -EINVAL;
+		tc_class[fd] = tc_by_svc[svc];
+		tc_svc[fd] = (signed char) svc;
+		tc_svc_set[fd / 8] |= (unsigned char) (1 << (fd % 8));
+		return 0;
+	}
+	// so_set_traffic_class(): SO_TC_BE (0) .. SO_TC_CTL (900); in-between values round to their class (so_tc2msc)
+	if (v < 0 || v > 900)
+		return -EINVAL;
+	tc_class[fd] = (short) (v / 100 * 100);
+	tc_svc_set[fd / 8] &= (unsigned char) ~(1 << (fd % 8));
+	return 0;
+}
+
+long sockextra_get_tc(int fd, int optname, void* optval, int* optlen)
+{
+	int r = tc_sock(fd);
+	if (r < 0)
+		return r;
+	if (optlen == NULL)
+		return -EFAULT;
+	int v = 0;
+	if (fd >= 0 && fd < IDLE_FDS) {
+		if (optname == BSD_SO_RECV_TRAFFIC_CLASS)
+			v = !!(tc_recv[fd / 8] & (1 << (fd % 8)));
+		else if (optname == BSD_SO_NET_SERVICE_TYPE)
+			v = (tc_svc_set[fd / 8] & (1 << (fd % 8))) ? tc_svc[fd] : 0;
+		else
+			v = tc_class[fd];
+	}
+	if (optval == NULL) { *optlen = 0; return 0; }
+	int n = *optlen < (int) sizeof(v) ? *optlen : (int) sizeof(v);
+	if (n < 0)
+		return -EINVAL;
+	for (int i = 0; i < n; i++) ((char*) optval)[i] = ((char*) &v)[i];
+	*optlen = n;
+	return 0;
+}
+
+static unsigned char anyif_flags[IDLE_FDS / 8], recvif_flags[IDLE_FDS / 8], recvdst_flags[IDLE_FDS / 8], pktinfo_user[IDLE_FDS / 8];
+#define BIT(a, fd) ((fd) >= 0 && (fd) < IDLE_FDS && ((a)[(fd) / 8] & (1 << ((fd) % 8))))
+static void setbit_(unsigned char* a, int fd, int on)
+{
+	if (fd < 0 || fd >= IDLE_FDS) return;
+	if (on) a[fd / 8] |= (unsigned char) (1 << (fd % 8));
+	else a[fd / 8] &= (unsigned char) ~(1 << (fd % 8));
+}
+
+void sockextra_note_pktinfo(int fd, int on) { setbit_(pktinfo_user, fd, on); }
+int sockextra_recvif(int fd) { return BIT(recvif_flags, fd) ? 1 : 0; }
+int sockextra_pktinfo_user(int fd) { return BIT(pktinfo_user, fd) ? 1 : 0; }
+int sockextra_recvdst(int fd) { return BIT(recvdst_flags, fd) ? 1 : 0; }
+
+long sockextra_set_flag(int fd, int level, int optname, const void* optval, int optlen)
+{
+	int d = l_domain(fd);
+	if (d < 0)
+		return -ENOTSOCK;
+	if (optval == NULL || optlen < (int) sizeof(int))
+		return -EINVAL;
+	int on = *(const int*) optval != 0;
+	if (level == 0 && (optname == BSD_IP_RECVIF || optname == BSD_IP_RECVDSTADDR_OPT)) {
+		if (d != L_AF_INET && d != L_AF_INET6)
+			return -EINVAL;
+		// Linux IP_PKTINFO (8) carries the index and the destination; on while any of the three options is
+		int other = optname == BSD_IP_RECVIF ? BIT(recvdst_flags, fd) : BIT(recvif_flags, fd);
+		int v = on || other || BIT(pktinfo_user, fd);
+#ifdef __NR_socketcall
+		long r = LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_SETSOCKOPT, ((long[6]) { fd, 0, 8, &v, sizeof(v), 0 }));
+#else
+		long r = LINUX_SYSCALL(__NR_setsockopt, fd, 0, 8, &v, sizeof(v));
+#endif
+		if (r < 0)
+			return errno_linux_to_bsd(r);
+		setbit_(optname == BSD_IP_RECVIF ? recvif_flags : recvdst_flags, fd, on);
+		return 0;
+	}
+	setbit_(anyif_flags, fd, on); // SO_RECV_ANYIF
+	return 0;
+}
+
+long sockextra_get_flag(int fd, int level, int optname, void* optval, int* optlen)
+{
+	if (l_domain(fd) < 0)
+		return -ENOTSOCK;
+	if (optlen == NULL)
+		return -EFAULT;
+	int v = (level == 0 && optname == BSD_IP_RECVIF) ? sockextra_recvif(fd)
+		: (level == 0 && optname == BSD_IP_RECVDSTADDR_OPT) ? sockextra_recvdst(fd) : (BIT(anyif_flags, fd) ? 1 : 0);
+	if (optval == NULL) { *optlen = 0; return 0; }
+	int n = *optlen < (int) sizeof(v) ? *optlen : (int) sizeof(v);
+	if (n < 0)
+		return -EINVAL;
+	for (int i = 0; i < n; i++) ((char*) optval)[i] = ((char*) &v)[i];
+	*optlen = n;
+	return 0;
+}
+
+void sockextra_closed(int fd)
+{
+	setbit_(anyif_flags, fd, 0); setbit_(recvif_flags, fd, 0); setbit_(recvdst_flags, fd, 0); setbit_(pktinfo_user, fd, 0);
+	if (fd >= 0 && fd < IDLE_FDS) {
+		idle_flags[fd / 8] &= (unsigned char) ~(1 << (fd % 8));
+		tc_class[fd] = 0;
+		tc_recv[fd / 8] &= (unsigned char) ~(1 << (fd % 8));
+		tc_svc_set[fd / 8] &= (unsigned char) ~(1 << (fd % 8));
+	}
+}
+
+// XNU's struct so_cinforeq (64-bit user), bsd/sys/socket_private.h
+struct xnu_so_cinforeq {
+	uint32_t scir_cid;
+	uint32_t scir_flags;
+	uint32_t scir_ifindex;
+	int32_t scir_error;
+	void* scir_src;
+	uint32_t scir_src_len;
+	void* scir_dst __attribute__((aligned(8)));
+	uint32_t scir_dst_len;
+	uint32_t scir_aux_type;
+	void* scir_aux_data;
+	uint32_t scir_aux_len;
+};
+_Static_assert(sizeof(struct xnu_so_cinforeq) == 64, "so_cinforeq is 64 bytes");
+#define CIF_CONNECTED 0x2
+#define CIF_BOUND_IF 0x10
+#define CIF_BOUND_IP 0x20
+#define CIAUX_TCP 0x1
+#define SAE_CONNID_ANY 0
+#define SAE_CONNID_ALL ((uint32_t) -1)
+
+long sockextra_conninfo(int fd, void* arg)
+{
+	struct xnu_so_cinforeq* r = arg;
+	int d = l_domain(fd);
+	if (d < 0)
+		return -ENOTSOCK;
+	if (d != L_AF_INET && d != L_AF_INET6)
+		return -EINVAL; // as XNU: in_getconninfo is the INET protocols'
+	// XNU (in_getconninfo): only SAE_CONNID_ANY/ALL or the socket's one connection (1)
+	if (r->scir_cid != SAE_CONNID_ANY && r->scir_cid != SAE_CONNID_ALL && r->scir_cid != 1)
+		return -EINVAL;
+
+	uint32_t flags = 0;
+	unsigned char sa[128];
+	unsigned int len = sizeof(sa);
+	if (l_name(fd, 1, sa, &len) >= 0)
+		flags |= CIF_CONNECTED;
+	int bound = 0;
+	len = sizeof(bound);
+	if (l_getsockopt(fd, L_SOL_SOCKET, L_SO_BINDTOIFINDEX, &bound, &len) >= 0 && bound > 0)
+		flags |= CIF_BOUND_IF;
+	int err = 0;
+	len = sizeof(err);
+	l_getsockopt(fd, L_SOL_SOCKET, L_SO_ERROR, &err, &len);
+
+	r->scir_flags = flags;
+	r->scir_ifindex = sockextra_out_ifindex(fd);
+	r->scir_error = err ? errno_linux_to_bsd(-err) * -1 : 0;
+
+	// addresses: copied out up to the length given (XNU copies min(len, sa_len) and returns the full length)
+	if (r->scir_src && r->scir_src_len > 0) {
+		unsigned char tmp[128];
+		int l = sizeof(tmp);
+		if (sys_getsockname(fd, tmp, &l) == 0) {
+			int n = (int) r->scir_src_len < l ? (int) r->scir_src_len : l;
+			for (int i = 0; i < n; i++) ((unsigned char*) r->scir_src)[i] = tmp[i];
+			r->scir_src_len = l;
+		} else r->scir_src_len = 0;
+	}
+	if (r->scir_dst && r->scir_dst_len > 0) {
+		unsigned char tmp[128];
+		int l = sizeof(tmp);
+		if (sys_getpeername(fd, tmp, &l) == 0) {
+			int n = (int) r->scir_dst_len < l ? (int) r->scir_dst_len : l;
+			for (int i = 0; i < n; i++) ((unsigned char*) r->scir_dst)[i] = tmp[i];
+			r->scir_dst_len = l;
+		} else r->scir_dst_len = 0;
+	}
+
+	// aux: a TCP socket's tcp_connection_info (CIAUX_TCP), as XNU's tcp_getconninfo()
+	int type = 0;
+	len = sizeof(type);
+	l_getsockopt(fd, L_SOL_SOCKET, 3 /* SO_TYPE */, &type, &len);
+	if (type == 1 /* SOCK_STREAM */) {
+		r->scir_aux_type = CIAUX_TCP;
+		if (r->scir_aux_data && r->scir_aux_len >= sizeof(struct xnu_tcp_connection_info)) {
+			int l = sizeof(struct xnu_tcp_connection_info);
+			if (tcp_info_option(fd, BSD_TCP_CONNECTION_INFO, r->scir_aux_data, &l) == 0)
+				r->scir_aux_len = l;
+		} else {
+			r->scir_aux_len = sizeof(struct xnu_tcp_connection_info);
+		}
+	} else {
+		r->scir_aux_type = 0;
+		r->scir_aux_len = 0;
+	}
+	return 0;
+}
+
+// XNU's IFRTYPE_FUNCTIONAL_* (net/if.h)
+#define IFRTYPE_FUNCTIONAL_UNKNOWN 0
+#define IFRTYPE_FUNCTIONAL_LOOPBACK 1
+#define IFRTYPE_FUNCTIONAL_WIRED 2
+#define IFRTYPE_FUNCTIONAL_WIFI_INFRA 3
+#define L_SIOCGIFHWADDR 0x8927
+#define L_SIOCGIWNAME 0x8b01
+#define L_ARPHRD_ETHER 1
+#define L_ARPHRD_LOOPBACK 772
+
+// The interface's functional type from Linux's link type: loopback, Wi-Fi (a wireless extension answers SIOCGIWNAME),
+// other Ethernet as wired, anything else unknown. Network.framework's nw_path interface type comes from this (it was
+// passed through to Linux and failed): GeoServices' GEONetworkObserver counts a satisfied path as reachable only over
+// Wi-Fi, cellular or wired, so Maps showed "No Internet Connection" over an "other" interface.
+#define L_SIOCGIFMTU 0x8921
+
+long sockextra_mtu(int fd, void* arg)
+{
+	struct { char name[16]; int mtu; char pad[20]; } q;
+	char* ifr = arg;
+	memset(&q, 0, sizeof(q));
+	for (int i = 0; i < 15 && ifr[i]; i++) q.name[i] = ifr[i];
+	long r = LINUX_SYSCALL(__NR_ioctl, fd, L_SIOCGIFMTU, &q);
+	if (r < 0)
+		return errno_linux_to_bsd(r);
+	*(int*) (ifr + 16) = q.mtu;
+	return 0;
+}
+
+#define L_SIOCGIFFLAGS 0x8913
+long sockextra_ifflags(int fd, void* arg)
+{
+	struct { char name[16]; union { short flags; struct { uint16_t family; char data[14]; } hw; char pad[24]; }; } q;
+	char* ifr = arg;
+	memset(&q, 0, sizeof(q));
+	for (int i = 0; i < 15 && ifr[i]; i++) q.name[i] = ifr[i];
+	long r = LINUX_SYSCALL(__NR_ioctl, fd, L_SIOCGIFFLAGS, &q);
+	if (r < 0)
+		return errno_linux_to_bsd(r);
+	unsigned int lf = (unsigned short) q.flags;
+	// the low ten bits are Darwin's too except 0x400 (Linux IFF_MASTER, Darwin IFF_OACTIVE); IFF_MULTICAST 0x1000 -> 0x8000
+	unsigned int f = lf & 0x3ff;
+	if (lf & 0x1000)
+		f |= 0x8000;
+	memset(&q, 0, sizeof(q));
+	for (int i = 0; i < 15 && ifr[i]; i++) q.name[i] = ifr[i];
+	if (LINUX_SYSCALL(__NR_ioctl, fd, L_SIOCGIFHWADDR, &q) >= 0 && q.hw.family == L_ARPHRD_ETHER)
+		f |= 0x800; // IFF_SIMPLEX: an Ethernet interface can't hear its own transmissions, as Darwin's say
+	*(short*) (ifr + 16) = (short) f;
+	return 0;
+}
+
+long sockextra_functional_type(int fd, void* arg)
+{
+	struct { char name[16]; union { struct { uint16_t family; char data[14]; } hw; uint32_t ftype; char pad[16]; }; } q;
+	char* ifr = arg;
+	memset(&q, 0, sizeof(q));
+	for (int i = 0; i < 15 && ifr[i]; i++) q.name[i] = ifr[i];
+	long r = LINUX_SYSCALL(__NR_ioctl, fd, L_SIOCGIFHWADDR, &q);
+	if (r < 0)
+		return errno_linux_to_bsd(r); // ENXIO for an unknown interface, as XNU
+	uint32_t type = IFRTYPE_FUNCTIONAL_UNKNOWN;
+	if (q.hw.family == L_ARPHRD_LOOPBACK)
+		type = IFRTYPE_FUNCTIONAL_LOOPBACK;
+	else if (q.hw.family == L_ARPHRD_ETHER) {
+		char w[32];
+		memset(w, 0, sizeof(w));
+		for (int i = 0; i < 15 && ifr[i]; i++) w[i] = ifr[i];
+		type = LINUX_SYSCALL(__NR_ioctl, fd, L_SIOCGIWNAME, w) >= 0 ? IFRTYPE_FUNCTIONAL_WIFI_INFRA : IFRTYPE_FUNCTIONAL_WIRED;
+	}
+	*(uint32_t*) (ifr + 16) = type;
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sockutil.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sockutil.c
new file mode 100644
index 00000000..118c0b62
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sockutil.c
@@ -0,0 +1,49 @@
+// x86Sim: ported from willi/darling-xnu#8 (research/willi/darling-xnu-8.diff); see FINDINGS.md "Spike 3.8"
+#include <darling/emulation/xnu_syscall/bsd/helper/network/sockutil.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+
+#define LINUX_SOL_SOCKET 1
+#define LINUX_SO_COOKIE 57
+#define LINUX_SOL_TCP 6
+#define LINUX_TCP_INFO 11
+#define LINUX_SYS_GETSOCKOPT 15
+#define LINUX_EINVAL 22
+
+long linux_getsockopt(int fd, int level, int name, void* value, unsigned int* len)
+{
+#ifdef __NR_socketcall
+	return LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_GETSOCKOPT, ((long[6]) { fd, level, name, value, len, 0 }));
+#else
+	return LINUX_SYSCALL(__NR_getsockopt, fd, level, name, value, len);
+#endif
+}
+
+long linux_socket_cookie(int fd, unsigned long long* cookie)
+{
+	unsigned int len = sizeof(*cookie);
+	return linux_getsockopt(fd, LINUX_SOL_SOCKET, LINUX_SO_COOKIE, cookie, &len);
+}
+
+long linux_tcp_info(int fd, struct linux_tcp_info* info)
+{
+	unsigned int len = sizeof(*info);
+	long ret = linux_getsockopt(fd, LINUX_SOL_TCP, LINUX_TCP_INFO, info, &len);
+
+	// x86Sim (Speed 27): Linux's tcp_get_info() reads the state without the socket's lock, so a read that races
+	// connect() on another thread can see CLOSE with the SYN already counted (segs_out 1). That reads as a socket
+	// that was connected and is closed now (sostate.c: disconnected): libkqueue then kept a new socket's hang-up as
+	// EOF and Network.framework failed the connection "Network is down" (the first connection of mobileassetd,
+	// WebKit's Networking process ...). connect() sets SYN_SENT before it sends, so one more read is consistent.
+	if (ret == 0 && len >= sizeof(*info) && info->state == LINUX_TCP_CLOSE && (info->segs_out || info->segs_in))
+	{
+		len = sizeof(*info);
+		ret = linux_getsockopt(fd, LINUX_SOL_TCP, LINUX_TCP_INFO, info, &len);
+	}
+
+	// a kernel whose tcp_info is shorter than this one's (before 4.2)
+	if (ret == 0 && len < sizeof(*info))
+		return -LINUX_EINVAL;
+	return ret;
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sostate.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sostate.c
new file mode 100644
index 00000000..654c1239
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/sostate.c
@@ -0,0 +1,541 @@
+// x86Sim: ported from willi/darling-xnu#8 (research/willi/darling-xnu-8.diff); see FINDINGS.md "Spike 3.8"
+#include <darling/emulation/xnu_syscall/bsd/helper/network/sostate.h>
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/errno.h>
+#include <libsimple/lock.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/common/sigsafe_lock.h>
+#include <darling/emulation/conversion/errno.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <darling/emulation/xnu_syscall/bsd/helper/network/sockutil.h>
+
+#define LINUX_SOL_SOCKET 1
+#define LINUX_SO_ERROR 4
+#define LINUX_SYS_GETPEERNAME 7
+
+#define LINUX_POLLIN 0x0001
+#define LINUX_POLLOUT 0x0004
+#define LINUX_POLLERR 0x0008
+#define LINUX_POLLHUP 0x0010
+#define LINUX_POLLRDHUP 0x2000
+
+// shutdown()'s how, the same on XNU and Linux
+#define SHUT_RD 0
+#define SHUT_WR 1
+
+struct linux_pollfd {
+	int fd;
+	short events;
+	short revents;
+};
+
+struct linux_timespec {
+	long tv_sec;
+	long tv_nsec;
+};
+
+static long linux_getpeername(int fd)
+{
+	char addr[128];
+	unsigned int len = sizeof(addr);
+#ifdef __NR_socketcall
+	return LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_GETPEERNAME, ((long[6]) { fd, addr, &len }));
+#else
+	return LINUX_SYSCALL(__NR_getpeername, fd, addr, &len);
+#endif
+}
+
+// The sockets remembered: those holding an error (taken from Linux, not yet by the program), and those EVFILT_SOCK
+// knotes watch, with what the knotes need. Every access takes the lock, which blocks signals while held
+// (sigsafe_lock.h).
+struct socket_entry {
+	unsigned long long cookie; // 0: free (Linux's socket cookies start at 1)
+	unsigned long long order;  // when it was remembered: a full table forgets the oldest
+	int held;                  // the held error (a BSD errno), 0 if none
+	int watchers;              // the EVFILT_SOCK knotes watching it
+	// While watched: the hint sequence number of its newest error raising NOTE_CONNRESET, and NOTE_TIMEOUT (0 if
+	// none). A sequence shared by all sockets, so that an entry forgotten and made again never repeats a value.
+	unsigned int resets;
+	unsigned int timeouts;
+	unsigned char shut;        // SOSTATE_CANTRCVMORE, SOSTATE_CANTSENDMORE: shut down while watched
+	// A send's EPIPE on it is only that (it can't send), not a reset whose error the send cleared: it has been shut
+	// down for sending, its error was seen, or it was watched too late to tell (socket_error_send)
+	unsigned char epipe_plain;
+};
+
+static struct socket_entry entries[SOCKET_ENTRIES_MAX];
+static unsigned long long entries_order;
+static unsigned int hint_seq;
+static libsimple_lock_t entries_lock = LIBSIMPLE_LOCK_INITIALIZER;
+volatile int socket_errors_held;
+volatile int socket_errors_taking;
+volatile int socket_entries_used;
+volatile int socket_watchers;
+
+static struct socket_entry* find_locked(unsigned long long cookie)
+{
+	for (int i = 0; i < SOCKET_ENTRIES_MAX; i++) {
+		if (entries[i].cookie == cookie)
+			return &entries[i];
+	}
+	return NULL;
+}
+
+static void unhold_locked(struct socket_entry* e)
+{
+	if (e->held != 0) {
+		e->held = 0;
+		__atomic_sub_fetch(&socket_errors_held, 1, __ATOMIC_SEQ_CST);
+	}
+}
+
+static void forget_locked(struct socket_entry* e)
+{
+	unhold_locked(e);
+	e->cookie = 0;
+	__atomic_sub_fetch(&socket_entries_used, 1, __ATOMIC_SEQ_CST);
+}
+
+// An entry that holds no error and that no knote watches is forgotten
+static void tidy_locked(struct socket_entry* e)
+{
+	if (e->held == 0 && e->watchers == 0)
+		forget_locked(e);
+}
+
+// The socket's entry, made if it has none. A full table forgets the oldest entry, one that is only watched (losing
+// hints) before one holding an error (losing the error).
+static struct socket_entry* entry_locked(unsigned long long cookie)
+{
+	struct socket_entry* e = find_locked(cookie);
+
+	if (e != NULL)
+		return e;
+	e = find_locked(0);
+	if (e == NULL) {
+		e = &entries[0];
+		for (int i = 1; i < SOCKET_ENTRIES_MAX; i++) {
+			struct socket_entry* c = &entries[i];
+			if ((c->held != 0) < (e->held != 0) || ((c->held != 0) == (e->held != 0) && c->order < e->order))
+				e = c;
+		}
+		forget_locked(e);
+	}
+	e->cookie = cookie;
+	e->order = ++entries_order;
+	e->held = 0;
+	e->watchers = 0;
+	e->resets = 0;
+	e->timeouts = 0;
+	e->shut = 0;
+	e->epipe_plain = 0;
+	__atomic_add_fetch(&socket_entries_used, 1, __ATOMIC_SEQ_CST);
+	return e;
+}
+
+static void hold_locked(struct socket_entry* e, int error)
+{
+	if (e->held == 0)
+		__atomic_add_fetch(&socket_errors_held, 1, __ATOMIC_SEQ_CST);
+	e->held = error;
+}
+
+// The socket had error: counted for its knotes' hints (XNU's TCP posts NOTE_CONNRESET from tcp_input()'s RST
+// handling, NOTE_TIMEOUT from tcp_timers()' drops, which also time out with the unreachable errors)
+static void errored_locked(struct socket_entry* e, int error)
+{
+	e->epipe_plain = 1;
+	if (e->watchers == 0)
+		return;
+	switch (error) {
+	case ECONNREFUSED:
+	case ECONNRESET:
+		e->resets = ++hint_seq;
+		break;
+	case ETIMEDOUT:
+	case EHOSTUNREACH:
+	case ENETUNREACH:
+	case EHOSTDOWN:
+	case ENETDOWN:
+		e->timeouts = ++hint_seq;
+		break;
+	}
+}
+
+void socket_errors_atfork_child(void)
+{
+	// The child has only the forking thread: nobody holds the lock, or is taking an error. It keeps the held errors:
+	// its sockets are the parent's. It has no knotes: libkqueue's kqueue_atfork() drops the parent's kqueues without
+	// deleting their knotes, so nothing would ever stop their watches.
+	libsimple_lock_init(&entries_lock);
+	socket_errors_taking = 0;
+	socket_watchers = 0;
+	for (int i = 0; i < SOCKET_ENTRIES_MAX; i++) {
+		if (entries[i].cookie != 0) {
+			entries[i].watchers = 0;
+			tidy_locked(&entries[i]);
+		}
+	}
+}
+
+// The errors Linux sets on a socket (sk_err) for its peer or the network
+static int is_socket_error(int error)
+{
+	switch (error) {
+	case ECONNREFUSED:
+	case ECONNRESET:
+	case ECONNABORTED:
+	case EPIPE:
+	case ETIMEDOUT:
+	case EHOSTUNREACH:
+	case ENETUNREACH:
+	case EHOSTDOWN:
+	case ENETDOWN:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+// A TCP socket's error as XNU's TCP would have set it: Linux sets EPIPE for a reset in CLOSE_WAIT, where XNU's
+// tcp_input() sets ECONNRESET as in the other synchronized states
+static int tcp_error(int error)
+{
+	return error == EPIPE ? ECONNRESET : error;
+}
+
+static int is_tcp(int fd)
+{
+	struct linux_tcp_info info;
+	return linux_tcp_info(fd, &info) == 0;
+}
+
+// XNU's so_state for a TCP socket in Linux state info->state. A socket that is closed (or in TIME_WAIT, which Linux
+// reports as closed) after any segment went either way has been disconnected (XNU's tcp_close() calls
+// soisdisconnected()); one that has seen none is new.
+static unsigned tcp_state(const struct linux_tcp_info* info)
+{
+	switch (info->state) {
+	case LINUX_TCP_ESTABLISHED:
+		return SOSTATE_ISCONNECTED;
+	case LINUX_TCP_CLOSE_WAIT:
+		return SOSTATE_ISCONNECTED | SOSTATE_CANTRCVMORE;
+	case LINUX_TCP_FIN_WAIT1:
+	case LINUX_TCP_FIN_WAIT2:
+		return SOSTATE_ISCONNECTED | SOSTATE_CANTSENDMORE;
+	case LINUX_TCP_CLOSING:
+	case LINUX_TCP_LAST_ACK:
+		return SOSTATE_ISCONNECTED | SOSTATE_CANTRCVMORE | SOSTATE_CANTSENDMORE;
+	case LINUX_TCP_TIME_WAIT:
+	case LINUX_TCP_CLOSE:
+		return (info->segs_out || info->segs_in) ? SOSTATE_ISDISCONNECTED | SOSTATE_CANTRCVMORE | SOSTATE_CANTSENDMORE
+			: 0;
+	default: // SYN_SENT, SYN_RECV, LISTEN
+		return 0;
+	}
+}
+
+// Whether a TCP socket in this state certainly hasn't been shut down for sending (it sent no FIN): a later EPIPE
+// from Linux on it, once it's closed, is then a reset after the peer's FIN
+static int tcp_not_shut(const struct linux_tcp_info* info)
+{
+	switch (info->state) {
+	case LINUX_TCP_SYN_SENT:
+	case LINUX_TCP_ESTABLISHED:
+	case LINUX_TCP_CLOSE_WAIT:
+		return 1;
+	case LINUX_TCP_CLOSE:
+		return !(info->segs_out || info->segs_in); // new
+	default:
+		return 0;
+	}
+}
+
+// Takes a closed TCP socket's error from Linux and holds it. Readers that found nothing in Linux meanwhile see
+// socket_errors_taking, and wait for the lock to find it held.
+static void take_tcp_error(int fd, unsigned long long cookie)
+{
+	int linux_error = 0;
+	unsigned int len = sizeof(linux_error);
+	unsigned long long mask;
+
+	__atomic_add_fetch(&socket_errors_taking, 1, __ATOMIC_SEQ_CST);
+	mask = sigsafe_lock(&entries_lock);
+	if (linux_getsockopt(fd, LINUX_SOL_SOCKET, LINUX_SO_ERROR, &linux_error, &len) == 0 && linux_error != 0) {
+		int error = tcp_error(errno_linux_to_bsd(linux_error));
+		struct socket_entry* e = entry_locked(cookie);
+		hold_locked(e, error);
+		errored_locked(e, error);
+	}
+	sigsafe_unlock(&entries_lock, mask);
+	__atomic_sub_fetch(&socket_errors_taking, 1, __ATOMIC_SEQ_CST);
+}
+
+int socket_state(int fd, struct socket_state_4libkqueue* st)
+{
+	unsigned long long cookie;
+	struct linux_pollfd pfd = { .fd = fd, .events = LINUX_POLLIN | LINUX_POLLOUT | LINUX_POLLRDHUP };
+	struct linux_timespec now = { 0, 0 };
+	struct linux_tcp_info info;
+	long ret;
+
+	ret = linux_socket_cookie(fd, &cookie);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	ret = LINUX_SYSCALL(__NR_ppoll, &pfd, 1, &now, NULL, 8);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	st->error = 0;
+	st->resets = 0;
+	st->timeouts = 0;
+
+	if (linux_tcp_info(fd, &info) == 0) {
+		st->state = tcp_state(&info) | SOSTATE_EVCONNINFO;
+		// Linux reports a socket error (sk_err) as POLLERR. A closed TCP socket's is why it closed.
+		if ((pfd.revents & LINUX_POLLERR) && info.state == LINUX_TCP_CLOSE)
+			take_tcp_error(fd, cookie);
+	} else {
+		// Other sockets: one with a peer is connected until it hangs up (Linux: both directions shut down), then
+		// disconnected. A new stream socket hangs up too, but has no peer. Linux doesn't report a shutdown of only
+		// the sending direction: a watched socket's own shutdown() is remembered.
+		st->state = 0;
+		if (linux_getpeername(fd) == 0) {
+			if (pfd.revents & LINUX_POLLHUP)
+				st->state = SOSTATE_ISDISCONNECTED | SOSTATE_CANTRCVMORE | SOSTATE_CANTSENDMORE;
+			else
+				st->state = SOSTATE_ISCONNECTED;
+		}
+	}
+
+	// the receiving direction shut down (the peer's FIN, or shutdown(SHUT_RD))
+	if (pfd.revents & LINUX_POLLRDHUP)
+		st->state |= SOSTATE_CANTRCVMORE;
+
+	if (SOCKET_ENTRIES_USED()) {
+		unsigned long long mask = sigsafe_lock(&entries_lock);
+		struct socket_entry* e = find_locked(cookie);
+		if (e != NULL) {
+			st->state |= e->shut;
+			st->error = e->held;
+			st->resets = e->resets;
+			st->timeouts = e->timeouts;
+		}
+		sigsafe_unlock(&entries_lock, mask);
+	}
+
+	return 0;
+}
+
+int socket_error(int fd, int linux_error)
+{
+	struct linux_tcp_info info;
+	unsigned long long cookie;
+	int error = 0;
+
+	if (!linux_error && !SOCKET_ERRORS_HELD())
+		return 0;
+	if (linux_socket_cookie(fd, &cookie) < 0)
+		return 0;
+	if (linux_error && linux_tcp_info(fd, &info) == 0 && info.state == LINUX_TCP_CLOSE)
+		take_tcp_error(fd, cookie);
+	if (SOCKET_ENTRIES_USED()) {
+		unsigned long long mask = sigsafe_lock(&entries_lock);
+		struct socket_entry* e = find_locked(cookie);
+		if (e != NULL)
+			error = e->held;
+		sigsafe_unlock(&entries_lock, mask);
+	}
+	return error;
+}
+
+void socket_watch(int fd, int delta)
+{
+	struct linux_tcp_info info;
+	unsigned long long cookie, mask;
+	int plain = 1;
+
+	// the gates open before the entry is made, and close after it's gone
+	if (delta > 0)
+		__atomic_add_fetch(&socket_watchers, 1, __ATOMIC_SEQ_CST);
+
+	if (linux_socket_cookie(fd, &cookie) == 0) {
+		if (delta > 0 && linux_tcp_info(fd, &info) == 0)
+			plain = !tcp_not_shut(&info);
+		mask = sigsafe_lock(&entries_lock);
+		struct socket_entry* e = delta > 0 ? entry_locked(cookie) : find_locked(cookie);
+		if (e != NULL) {
+			if (delta > 0) {
+				e->watchers++;
+				e->epipe_plain |= plain;
+			} else if (e->watchers > 0) {
+				e->watchers--;
+				tidy_locked(e);
+			}
+		}
+		sigsafe_unlock(&entries_lock, mask);
+	}
+
+	if (delta < 0)
+		__atomic_sub_fetch(&socket_watchers, 1, __ATOMIC_SEQ_CST);
+}
+
+void socket_shutdown(int fd, int how)
+{
+	unsigned long long cookie;
+
+	if (linux_socket_cookie(fd, &cookie) < 0)
+		return;
+
+	unsigned long long mask = sigsafe_lock(&entries_lock);
+	struct socket_entry* e = find_locked(cookie);
+	if (e != NULL && e->watchers > 0) {
+		// XNU's soshutdown(): sorflush() for reading, the protocol's pru_shutdown() (socantsendmore()) for sending
+		if (how != SHUT_WR)
+			e->shut |= SOSTATE_CANTRCVMORE;
+		if (how != SHUT_RD) {
+			e->shut |= SOSTATE_CANTSENDMORE;
+			e->epipe_plain = 1;
+		}
+	}
+	sigsafe_unlock(&entries_lock, mask);
+}
+
+// Linux returned error, its own, to the program: the socket's one error is now that, so the held one goes
+static void linux_gave_error(unsigned long long cookie, int error)
+{
+	unsigned long long mask = sigsafe_lock(&entries_lock);
+	struct socket_entry* e = find_locked(cookie);
+
+	if (e != NULL) {
+		unhold_locked(e);
+		errored_locked(e, error);
+		tidy_locked(e);
+	}
+	sigsafe_unlock(&entries_lock, mask);
+}
+
+// The held error, cleared unless peek; 0 if none
+static int held_error(unsigned long long cookie, int peek)
+{
+	int error = 0;
+	unsigned long long mask = sigsafe_lock(&entries_lock);
+	struct socket_entry* e = find_locked(cookie);
+
+	if (e != NULL && e->held != 0) {
+		error = e->held;
+		if (!peek) {
+			unhold_locked(e);
+			tidy_locked(e);
+		}
+	}
+	sigsafe_unlock(&entries_lock, mask);
+	return error;
+}
+
+int socket_error_take(int fd, int error)
+{
+	unsigned long long cookie;
+
+	if (linux_socket_cookie(fd, &cookie) < 0)
+		return error;
+
+	if (error != 0) {
+		if (error == EPIPE && is_tcp(fd))
+			error = tcp_error(error);
+		linux_gave_error(cookie, error);
+		return error;
+	}
+	return held_error(cookie, 0);
+}
+
+long socket_error_read(int fd, long ret, int peek, int eof)
+{
+	struct linux_tcp_info info;
+	unsigned long long cookie;
+
+	// no data: XNU's soreceive() returns the pending error before end of file or EWOULDBLOCK
+	if (ret == 0 || ret == -EAGAIN || ret == -ENOTCONN) {
+		// A reset after the peer's FIN closes a TCP socket with an error (Linux: EPIPE), but Linux's tcp_recvmsg()
+		// returns end of file first, leaving the error: taken here
+		if (ret == 0 && eof && linux_tcp_info(fd, &info) == 0 && info.state == LINUX_TCP_CLOSE
+				&& linux_socket_cookie(fd, &cookie) == 0)
+			take_tcp_error(fd, cookie);
+		if (!SOCKET_ERRORS_HELD() || linux_socket_cookie(fd, &cookie) < 0)
+			return ret;
+		int held = held_error(cookie, peek);
+		return held != 0 ? -held : ret;
+	}
+
+	if (!is_socket_error(-ret) || linux_socket_cookie(fd, &cookie) < 0)
+		return ret;
+	linux_gave_error(cookie, -ret);
+	return ret;
+}
+
+long socket_error_send(int fd, long ret)
+{
+	struct linux_tcp_info info;
+	unsigned long long cookie;
+	struct socket_entry* e;
+	int error = -ret, watched;
+
+	// XNU's sosendcheck() fails a send on a disconnected socket with EPIPE, before looking at so_error, which stays;
+	// Linux's TCP returns (and clears) the error that closed the socket
+	if (!is_socket_error(error))
+		return ret;
+	if (linux_tcp_info(fd, &info) < 0 || info.state != LINUX_TCP_CLOSE || linux_socket_cookie(fd, &cookie) < 0)
+		return ret;
+
+	unsigned long long mask = sigsafe_lock(&entries_lock);
+	if (error == EPIPE) {
+		// Linux's EPIPE is also its error for a reset after the peer's FIN, which the send cleared; the two can be
+		// told apart on a watched socket that hasn't been shut down for sending
+		e = find_locked(cookie);
+		if (e == NULL || e->watchers == 0 || e->epipe_plain) {
+			sigsafe_unlock(&entries_lock, mask);
+			return ret;
+		}
+		error = ECONNRESET;
+	} else
+		e = entry_locked(cookie);
+	hold_locked(e, tcp_error(error));
+	errored_locked(e, e->held);
+	watched = e->watchers > 0;
+	sigsafe_unlock(&entries_lock, mask);
+
+	// a knote that looked while the error was neither in Linux nor held looks again
+	if (watched)
+		SOCKET_CHANGED(fd);
+	return -EPIPE;
+}
+
+void socket_errors_forget(unsigned long long cookie)
+{
+	if (cookie == 0)
+		return;
+
+	unsigned long long mask = sigsafe_lock(&entries_lock);
+	struct socket_entry* e = find_locked(cookie);
+	if (e != NULL) {
+		unhold_locked(e);
+		tidy_locked(e);
+	}
+	sigsafe_unlock(&entries_lock, mask);
+}
+
+unsigned long long socket_errors_cookie(int fd)
+{
+	unsigned long long cookie;
+
+	return linux_socket_cookie(fd, &cookie) == 0 ? cookie : 0;
+}
+
+void socket_errors_close(int fd)
+{
+	socket_errors_forget(socket_errors_cookie(fd));
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/tcpinfo.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/tcpinfo.c
new file mode 100644
index 00000000..f16acd2f
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/tcpinfo.c
@@ -0,0 +1,291 @@
+// x86Sim: ported from willi/darling-xnu#25 (research/willi/darling-xnu-25.diff); see FINDINGS.md "Spike 3.8"
+#include <darling/emulation/xnu_syscall/bsd/helper/network/tcpinfo.h>
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/errno.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/conversion/errno.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <darling/emulation/xnu_syscall/bsd/helper/network/sockutil.h>
+
+extern void* memcpy(void* dest, const void* src, __SIZE_TYPE__ n);
+extern void* memset(void* dest, int c, __SIZE_TYPE__ n);
+
+#define LINUX_SOL_TCP 6
+#define LINUX_TCP_INFO 11
+#define LINUX_SIOCOUTQ 0x5411
+
+// Linux's struct tcp_info (include/uapi/linux/tcp.h), as far as this takes it; a kernel older than a field leaves it 0
+// (sockutil.h's linux_tcp_info is its start)
+struct linux_tcp_info_full {
+	uint8_t tcpi_state;
+	uint8_t tcpi_ca_state;
+	uint8_t tcpi_retransmits;
+	uint8_t tcpi_probes;
+	uint8_t tcpi_backoff;
+	uint8_t tcpi_options;
+	uint8_t tcpi_snd_wscale : 4, tcpi_rcv_wscale : 4;
+	uint8_t tcpi_delivery_rate_app_limited : 1, tcpi_fastopen_client_fail : 2;
+
+	uint32_t tcpi_rto;
+	uint32_t tcpi_ato;
+	uint32_t tcpi_snd_mss;
+	uint32_t tcpi_rcv_mss;
+
+	uint32_t tcpi_unacked;
+	uint32_t tcpi_sacked;
+	uint32_t tcpi_lost;
+	uint32_t tcpi_retrans;
+	uint32_t tcpi_fackets;
+
+	uint32_t tcpi_last_data_sent;
+	uint32_t tcpi_last_ack_sent;
+	uint32_t tcpi_last_data_recv;
+	uint32_t tcpi_last_ack_recv;
+
+	uint32_t tcpi_pmtu;
+	uint32_t tcpi_rcv_ssthresh;
+	uint32_t tcpi_rtt;
+	uint32_t tcpi_rttvar;
+	uint32_t tcpi_snd_ssthresh;
+	uint32_t tcpi_snd_cwnd;
+	uint32_t tcpi_advmss;
+	uint32_t tcpi_reordering;
+
+	uint32_t tcpi_rcv_rtt;
+	uint32_t tcpi_rcv_space;
+
+	uint32_t tcpi_total_retrans;
+
+	uint64_t tcpi_pacing_rate;
+	uint64_t tcpi_max_pacing_rate;
+	uint64_t tcpi_bytes_acked;
+	uint64_t tcpi_bytes_received;
+	uint32_t tcpi_segs_out;
+	uint32_t tcpi_segs_in;
+
+	uint32_t tcpi_notsent_bytes;
+	uint32_t tcpi_min_rtt;
+	uint32_t tcpi_data_segs_in;
+	uint32_t tcpi_data_segs_out;
+
+	uint64_t tcpi_delivery_rate;
+
+	uint64_t tcpi_busy_time;
+	uint64_t tcpi_rwnd_limited;
+	uint64_t tcpi_sndbuf_limited;
+
+	uint32_t tcpi_delivered;
+	uint32_t tcpi_delivered_ce;
+
+	uint64_t tcpi_bytes_sent;
+	uint64_t tcpi_bytes_retrans;
+	uint32_t tcpi_dsack_dups;
+	uint32_t tcpi_reord_seen;
+
+	uint32_t tcpi_rcv_ooopack;
+
+	uint32_t tcpi_snd_wnd;
+	uint32_t tcpi_rcv_wnd;	// Linux 6.2 on
+};
+
+// Linux's TCPI_OPT_* bits for these are XNU's
+#define LINUX_TCPI_OPT_MASK (TCPI_OPT_TIMESTAMPS | TCPI_OPT_SACK | TCPI_OPT_WSCALE | TCPI_OPT_ECN)
+#define LINUX_TCP_CA_RECOVERY 3
+#define LINUX_TCP_INFINITE_SSTHRESH 0x7fffffff
+// XNU's ssthresh before there's one: TCP_MAXWIN << TCP_MAX_WINSHIFT (tcp_newtcpcb())
+#define XNU_INITIAL_SSTHRESH (65535 << 14)
+
+// Linux's TCP states as XNU's
+static uint8_t tcp_state(uint8_t linux_state)
+{
+	switch (linux_state)
+	{
+		case LINUX_TCP_ESTABLISHED: return TCPS_ESTABLISHED;
+		case LINUX_TCP_SYN_SENT: return TCPS_SYN_SENT;
+		case LINUX_TCP_SYN_RECV: return TCPS_SYN_RECEIVED;
+		case LINUX_TCP_FIN_WAIT1: return TCPS_FIN_WAIT_1;
+		case LINUX_TCP_FIN_WAIT2: return TCPS_FIN_WAIT_2;
+		case LINUX_TCP_TIME_WAIT: return TCPS_TIME_WAIT;
+		case LINUX_TCP_CLOSE_WAIT: return TCPS_CLOSE_WAIT;
+		case LINUX_TCP_LAST_ACK: return TCPS_LAST_ACK;
+		case LINUX_TCP_LISTEN: return TCPS_LISTEN;
+		case LINUX_TCP_CLOSING: return TCPS_CLOSING;
+		default: return TCPS_CLOSED;
+	}
+}
+
+// what Linux knows of the connection (`got`: how much of it this kernel has), and the bytes in its send buffer
+static long read_linux_tcp_info(int fd, struct linux_tcp_info_full* info, unsigned int* got, uint32_t* sbbytes)
+{
+	unsigned int len = sizeof(*info);
+	int outq = 0;
+	long ret;
+
+	memset(info, 0, sizeof(*info));
+	ret = linux_getsockopt(fd, LINUX_SOL_TCP, LINUX_TCP_INFO, info, &len);
+	// Linux answers a socket that isn't TCP with EOPNOTSUPP (95), which comes out as EOPNOTSUPP (102), as XNU's
+	// uipc_ctloutput() answers a local socket (bsd/kern/uipc_usrreq.c:803). XNU answers a UDP or raw IP socket
+	// EINVAL (ip_ctloutput(), bsd/netinet/ip_output.c:2252; rip_ctloutput(), raw_ip.c:742), which this doesn't tell
+	// apart.
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+	*got = len;
+
+	// unsent and unacknowledged bytes, as XNU's so_snd.sb_cc; a listening socket has none
+	if (LINUX_SYSCALL(__NR_ioctl, fd, LINUX_SIOCOUTQ, &outq) < 0)
+		outq = 0;
+	*sbbytes = outq;
+	return 0;
+}
+
+static uint32_t bytes_of_segments(uint32_t segments, uint32_t mss)
+{
+	uint64_t bytes = (uint64_t) segments * mss;
+	return bytes > UINT32_MAX ? UINT32_MAX : (uint32_t) bytes;
+}
+
+// XNU's tcp_fill_info(), from Linux's: times in ms (Linux's are µs), windows and thresholds in bytes (Linux's are in
+// segments). Linux has no counterpart for the sequence numbers, the interface and its kind, the flow hash, the
+// connectivity probes or the TFO and ECN details, so they are 0.
+static void fill_info(const struct linux_tcp_info_full* l, unsigned int got, uint32_t sbbytes, struct xnu_tcp_info* ti)
+{
+	uint32_t mss = l->tcpi_snd_mss;
+
+	memset(ti, 0, sizeof(*ti));
+
+	ti->tcpi_state = tcp_state(l->tcpi_state);
+	ti->tcpi_options = l->tcpi_options & LINUX_TCPI_OPT_MASK;
+	if (ti->tcpi_options & TCPI_OPT_WSCALE)
+	{
+		ti->tcpi_snd_wscale = l->tcpi_snd_wscale;
+		ti->tcpi_rcv_wscale = l->tcpi_rcv_wscale;
+	}
+
+	/* Are we in retranmission episode */
+	if (l->tcpi_ca_state >= LINUX_TCP_CA_RECOVERY || l->tcpi_retransmits > 0)
+		ti->tcpi_flags |= TCPI_FLAG_LOSSRECOVERY;
+
+	// XNU's is 0 without its retransmit timer, which runs while there's data in flight
+	ti->tcpi_rto = l->tcpi_unacked ? l->tcpi_rto / 1000 : 0;
+	ti->tcpi_snd_mss = mss;
+	ti->tcpi_rcv_mss = mss;
+
+	// (Linux keeps no latest sample, only the smoothed RTT)
+	ti->tcpi_rttcur = l->tcpi_rtt / 1000;
+	ti->tcpi_srtt = l->tcpi_rtt / 1000;
+	ti->tcpi_rcv_srtt = l->tcpi_rcv_rtt / 1000;
+	ti->tcpi_rttvar = l->tcpi_rttvar / 1000;
+	// (Linux's minimum is ~0U until there's a sample; XNU's best starts at 0)
+	ti->tcpi_rttbest = (l->tcpi_min_rtt == UINT32_MAX) ? 0 : l->tcpi_min_rtt / 1000;
+
+	ti->tcpi_snd_ssthresh = (l->tcpi_snd_ssthresh >= LINUX_TCP_INFINITE_SSTHRESH) ? XNU_INITIAL_SSTHRESH
+		: bytes_of_segments(l->tcpi_snd_ssthresh, mss);
+	ti->tcpi_snd_cwnd = bytes_of_segments(l->tcpi_snd_cwnd, mss);
+	ti->tcpi_snd_sbbytes = sbbytes;
+
+	// what's left of the advertised window (rcv_adv - rcv_nxt): Linux's last advertised one, which differs only by what
+	// has come in since. A kernel before 6.2 hasn't got it: then its receive space, its estimate of the window the
+	// connection needs.
+	ti->tcpi_rcv_space = (got >= offsetof(struct linux_tcp_info_full, tcpi_rcv_wnd) + sizeof(l->tcpi_rcv_wnd))
+		? l->tcpi_rcv_wnd : l->tcpi_rcv_space;
+	ti->tcpi_snd_wnd = l->tcpi_snd_wnd;
+
+	ti->tcpi_txpackets = l->tcpi_segs_out;
+	ti->tcpi_txbytes = l->tcpi_bytes_sent;
+	ti->tcpi_txretransmitbytes = l->tcpi_bytes_retrans;
+	ti->tcpi_txretransmitpackets = l->tcpi_total_retrans;
+	// snd_max - snd_una: what the send buffer holds that has gone out
+	ti->tcpi_txunacked = (sbbytes > l->tcpi_notsent_bytes) ? sbbytes - l->tcpi_notsent_bytes : 0;
+
+	ti->tcpi_rxpackets = l->tcpi_segs_in;
+	ti->tcpi_rxbytes = l->tcpi_bytes_received;
+
+	ti->tcpi_ecn_success = (ti->tcpi_options & TCPI_OPT_ECN) ? 1 : 0;
+
+	ti->tcpi_rcvoopack = l->tcpi_rcv_ooopack;
+	ti->tcpi_reordered_pkts = l->tcpi_reord_seen;
+	ti->tcpi_dsack_recvd = l->tcpi_dsack_dups;
+}
+
+// XNU's tcp_connection_fill_info(): the same values, as tcp_fill_info() has them
+static void connection_fill_info(const struct xnu_tcp_info* ti, struct xnu_tcp_connection_info* tci)
+{
+	memset(tci, 0, sizeof(*tci));
+
+	tci->tcpi_state = ti->tcpi_state;
+	tci->tcpi_snd_wscale = ti->tcpi_snd_wscale;
+	tci->tcpi_rcv_wscale = ti->tcpi_rcv_wscale;
+	// the TCPCI_OPT_* bits are the TCPI_OPT_* ones
+	tci->tcpi_options = ti->tcpi_options;
+	if (ti->tcpi_flags & TCPI_FLAG_LOSSRECOVERY)
+		tci->tcpi_flags |= TCPCI_FLAG_LOSSRECOVERY;
+	// XNU's TF_PKTS_REORDERED: reordering seen on the connection
+	if (ti->tcpi_reordered_pkts > 0)
+		tci->tcpi_flags |= TCPCI_FLAG_REORDERING_DETECTED;
+	tci->tcpi_rto = ti->tcpi_rto;
+	tci->tcpi_maxseg = ti->tcpi_snd_mss;
+	tci->tcpi_snd_ssthresh = ti->tcpi_snd_ssthresh;
+	tci->tcpi_snd_cwnd = ti->tcpi_snd_cwnd;
+	tci->tcpi_snd_wnd = ti->tcpi_snd_wnd;
+	tci->tcpi_snd_sbbytes = ti->tcpi_snd_sbbytes;
+	tci->tcpi_rcv_wnd = ti->tcpi_rcv_space;
+	tci->tcpi_rttcur = ti->tcpi_rttcur;
+	tci->tcpi_srtt = ti->tcpi_srtt;
+	tci->tcpi_rttvar = ti->tcpi_rttvar;
+	tci->tcpi_txpackets = ti->tcpi_txpackets;
+	tci->tcpi_txbytes = ti->tcpi_txbytes;
+	tci->tcpi_txretransmitbytes = ti->tcpi_txretransmitbytes;
+	tci->tcpi_txretransmitpackets = ti->tcpi_txretransmitpackets;
+	tci->tcpi_rxpackets = ti->tcpi_rxpackets;
+	tci->tcpi_rxbytes = ti->tcpi_rxbytes;
+	tci->tcpi_rxoutoforderbytes = ti->tcpi_rxoutoforderbytes;
+}
+
+long tcp_info_option(int fd, int optname, void* optval, int* optlen)
+{
+	struct linux_tcp_info_full l;
+	struct xnu_tcp_info ti;
+	struct xnu_tcp_connection_info tci;
+	uint32_t sbbytes;
+	unsigned int got;
+	const void* value;
+	int size, n;
+	long ret;
+
+	// XNU's getsockopt() copies the length in only with a buffer, but out whenever the option is read
+	// (bsd/kern/uipc_syscalls.c:3317): a missing length is EFAULT, with a buffer or without
+	if (optlen == NULL)
+		return -EFAULT;
+
+	ret = read_linux_tcp_info(fd, &l, &got, &sbbytes);
+	if (ret < 0)
+		return ret;
+
+	fill_info(&l, got, sbbytes, &ti);
+	if (optname == BSD_TCP_CONNECTION_INFO)
+	{
+		connection_fill_info(&ti, &tci);
+		value = &tci;
+		size = sizeof(tci);
+	}
+	else
+	{
+		value = &ti;
+		size = sizeof(ti);
+	}
+
+	// sooptcopyout(): as much as fits
+	if (optval == NULL)
+	{
+		*optlen = 0;
+		return 0;
+	}
+	// (a socklen_t is unsigned: a length that reads as negative here is a large one, which gets the whole struct)
+	n = ((unsigned int) *optlen < (unsigned int) size) ? *optlen : size;
+	memcpy(optval, value, n);
+	*optlen = n;
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/aio/aio.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/aio/aio.c
new file mode 100644
index 00000000..24808459
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/aio/aio.c
@@ -0,0 +1,510 @@
+// x86Sim: POSIX asynchronous I/O (aio_read, aio_write, aio_fsync, aio_error, aio_return, aio_suspend, aio_cancel,
+// lio_listio), which Darling did not implement at all (ENOSYS). WebKit's GPU process caches media bytes through
+// MediaToolbox's aio_write; with ENOSYS its first load never completed and every later media load waited behind it.
+//
+// Requests complete synchronously when they are submitted (a pread/pwrite/fsync in the calling thread): the result
+// then waits in the table below for aio_error/aio_return, as a request on XNU's done queue does. Everything else
+// follows XNU's bsd/kern/kern_aio.c and, where they differ, what macOS 27 answers (tests/arm64/aioprobe.c, run on the
+// Mac: Apple's simulator uses that kernel):
+//   - a process has at most AIO_PROCESS_MAX (256, macOS 27's kern.aioprocmax) requests submitted and not yet reaped
+//     by aio_return; more fail with EAGAIN. That also bounds the table: a caller that never calls aio_return gets
+//     EAGAIN, not a leak;
+//   - an invalid request fails its submission with its own errno (macOS 27; the older kern_aio.c here said EAGAIN):
+//     EBADF (descriptor not open, or not for that access), ESPIPE (pipe, socket), EINVAL (length, buffer, offset,
+//     sigevent, lio opcode); lio_listio then submits nothing. An I/O error is the request's error (aio_error), with
+//     aio_return 0. LIO_NOP completes with 0;
+//   - SIGEV_SIGNAL sends the signal to the process on completion (for lio_listio, once, after the last request);
+//     SIGEV_THREAD is EINVAL (unsupported on XNU too). XNU has no EVFILT_AIO (bad_filtops), so no kevent side;
+//   - aio_suspend returns at once if a listed request is done, else waits (in short sleeps, interruptible) for
+//     another thread to submit one, until its timeout (EAGAIN);
+//   - aio_cancel never finds a request in flight: AIO_ALLDONE for a done one, as XNU answers for those.
+// The aiocb is the process's native LP64 layout, the same on arm64 and x86_64 (the translated guest's aiocb is read
+// as is).
+
+#include <darling/emulation/xnu_syscall/bsd/impl/aio/aio.h>
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/errno.h>
+#include <libsimple/lock.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/common/sigsafe_lock.h>
+#include <darling/emulation/conversion/errno.h>
+#include <darling/emulation/conversion/duct_errno.h>
+#include <darling/emulation/conversion/signal/duct_signals.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <darling/emulation/xnu_syscall/bsd/helper/bsdthread/cancelable.h>
+
+#define AIO_PROCESS_MAX 256 // kern.aioprocmax on macOS 27, where Apple's simulator runs
+#define AIO_LISTIO_MAX 16
+
+#define XNU_AIO_ALLDONE 0x1
+#define XNU_LIO_NOP 0x0
+#define XNU_LIO_READ 0x1
+#define XNU_LIO_WRITE 0x2
+#define XNU_LIO_NOWAIT 0x1
+#define XNU_LIO_WAIT 0x2
+#define XNU_SIGEV_NONE 0
+#define XNU_SIGEV_SIGNAL 1
+#define XNU_NSIG 32
+#define XNU_SIGKILL 9
+#define XNU_SIGSTOP 17
+#define XNU_O_SYNC 0x80
+#define XNU_O_DSYNC 0x400000
+
+#define LINUX_F_GETFL 3
+#define LINUX_O_ACCMODE 03
+#define LINUX_O_RDONLY 00
+#define LINUX_O_WRONLY 01
+#define LINUX_O_PATH 010000000
+#define LINUX_AT_EMPTY_PATH 0x1000
+#define LINUX_STATX_TYPE 0x1
+#define LINUX_S_IFMT 0170000
+#define LINUX_S_IFIFO 0010000
+#define LINUX_S_IFSOCK 0140000
+
+// <sys/signal.h> struct sigevent and <sys/aio.h> struct aiocb, in the native layout
+struct xnu_sigevent
+{
+	int sigev_notify;
+	int sigev_signo;
+	void* sigev_value;
+	void (*sigev_notify_function)(void*);
+	void* sigev_notify_attributes;
+};
+
+struct xnu_aiocb
+{
+	int aio_fildes;
+	long long aio_offset;
+	volatile void* aio_buf;
+	unsigned long aio_nbytes;
+	int aio_reqprio;
+	struct xnu_sigevent aio_sigevent;
+	int aio_lio_opcode;
+};
+
+enum op { OP_NOP, OP_READ, OP_WRITE, OP_FSYNC, OP_DSYNC };
+
+// A request from submission to aio_return. `aiocbp` NULL: a free slot; `done` 0: being performed by its submitter.
+struct request
+{
+	const void* aiocbp;
+	int fd;
+	int done;
+	int error;
+	long result;
+};
+
+static struct request requests[AIO_PROCESS_MAX];
+static int nrequests; // slots in use
+static libsimple_lock_t aio_lock = LIBSIMPLE_LOCK_INITIALIZER;
+static volatile unsigned int completions; // bumped on every completion, for aio_suspend
+
+void aio_postfork_child(void)
+{
+	for (int i = 0; i < AIO_PROCESS_MAX; i++)
+		requests[i].aiocbp = NULL;
+	nrequests = 0;
+	libsimple_lock_init(&aio_lock);
+}
+
+static int sigev_valid(const struct xnu_sigevent* sev)
+{
+	switch (sev->sigev_notify)
+	{
+		case XNU_SIGEV_SIGNAL:
+			return sev->sigev_signo > 0 && sev->sigev_signo < XNU_NSIG
+				&& sev->sigev_signo != XNU_SIGKILL && sev->sigev_signo != XNU_SIGSTOP;
+		case XNU_SIGEV_NONE:
+			return 1;
+		default: // SIGEV_THREAD is unsupported on XNU too
+			return 0;
+	}
+}
+
+// statx's leading fields, the same on every architecture
+struct linux_statx_head
+{
+	uint32_t stx_mask, stx_blksize;
+	uint64_t stx_attributes;
+	uint32_t stx_nlink, stx_uid, stx_gid;
+	uint16_t stx_mode;
+};
+
+// aio_validate: the descriptor is open for the access op needs (EBADF) and is not a pipe or socket (ESPIPE)
+static int fd_check(int fd, enum op op)
+{
+	long fl = LINUX_SYSCALL(__NR_fcntl, fd, LINUX_F_GETFL, 0);
+	if (fl < 0 || (fl & LINUX_O_PATH))
+		return EBADF;
+	int acc = fl & LINUX_O_ACCMODE;
+	if (op == OP_READ ? acc == LINUX_O_WRONLY : acc == LINUX_O_RDONLY)
+		return EBADF;
+
+	union { struct linux_statx_head h; char buf[256]; } stx;
+	if (LINUX_SYSCALL(__NR_statx, fd, "", LINUX_AT_EMPTY_PATH, LINUX_STATX_TYPE, &stx) < 0)
+		return EBADF;
+	int fmt = stx.h.stx_mode & LINUX_S_IFMT;
+	return fmt == LINUX_S_IFIFO || fmt == LINUX_S_IFSOCK ? ESPIPE : 0;
+}
+
+// aio_create_queue_entry + aio_validate: 0 or the errno the submission fails with
+static int request_check(const struct xnu_aiocb* cb, enum op op)
+{
+	if (op == OP_NOP)
+		return 0;
+	if (op == OP_READ || op == OP_WRITE)
+	{
+		if (cb->aio_nbytes > 0x7fffffff || cb->aio_buf == NULL || cb->aio_offset < 0)
+			return EINVAL;
+	}
+	if (!sigev_valid(&cb->aio_sigevent))
+		return EINVAL;
+	return fd_check(cb->aio_fildes, op);
+}
+
+// Takes a slot for aiocbp, or returns NULL when the process has AIO_PROCESS_MAX requests (EAGAIN)
+static struct request* request_reserve(const void* aiocbp, int fd)
+{
+	struct request* r = NULL;
+	unsigned long long mask = sigsafe_lock(&aio_lock);
+	if (nrequests < AIO_PROCESS_MAX)
+	{
+		for (int i = 0; i < AIO_PROCESS_MAX; i++)
+		{
+			if (requests[i].aiocbp == NULL)
+			{
+				r = &requests[i];
+				r->aiocbp = aiocbp;
+				r->fd = fd;
+				r->done = 0;
+				r->error = 0;
+				r->result = 0;
+				nrequests++;
+				break;
+			}
+		}
+	}
+	sigsafe_unlock(&aio_lock, mask);
+	return r;
+}
+
+// do_aio_read / do_aio_write / do_aio_fsync. Returns the BSD errno (0: success, result in *result).
+static int perform(const struct xnu_aiocb* cb, enum op op, long* result)
+{
+	long ret;
+
+	*result = 0;
+	switch (op)
+	{
+		case OP_READ:
+			ret = LINUX_SYSCALL(__NR_pread64, cb->aio_fildes, cb->aio_buf, cb->aio_nbytes, LL_ARG(cb->aio_offset));
+			break;
+		case OP_WRITE:
+			// with O_APPEND, Linux's pwrite appends like XNU's (which ignores the offset then)
+			ret = LINUX_SYSCALL(__NR_pwrite64, cb->aio_fildes, cb->aio_buf, cb->aio_nbytes, LL_ARG(cb->aio_offset));
+			break;
+		case OP_FSYNC:
+			ret = LINUX_SYSCALL(__NR_fsync, cb->aio_fildes);
+			break;
+		case OP_DSYNC:
+			ret = LINUX_SYSCALL(__NR_fdatasync, cb->aio_fildes);
+			break;
+		default: // LIO_NOP
+			return 0;
+	}
+	if (ret < 0)
+		return -errno_linux_to_bsd(ret);
+	*result = (op == OP_READ || op == OP_WRITE) ? ret : 0;
+	return 0;
+}
+
+static void request_complete(struct request* r, int error, long result)
+{
+	unsigned long long mask = sigsafe_lock(&aio_lock);
+	r->error = error;
+	r->result = result;
+	r->done = 1;
+	__atomic_add_fetch(&completions, 1, __ATOMIC_RELEASE);
+	sigsafe_unlock(&aio_lock, mask);
+}
+
+// psignal(p, signo): to the process, not the thread
+static void notify(const struct xnu_sigevent* sev)
+{
+	if (sev->sigev_notify != XNU_SIGEV_SIGNAL)
+		return;
+	int linux_signo = signum_bsd_to_linux(sev->sigev_signo);
+	if (linux_signo > 0)
+		LINUX_SYSCALL(__NR_kill, LINUX_SYSCALL0(__NR_getpid), linux_signo);
+}
+
+static enum op lio_op(int opcode)
+{
+	return opcode == XNU_LIO_READ ? OP_READ : opcode == XNU_LIO_WRITE ? OP_WRITE : OP_NOP;
+}
+
+// aio_queue_async_request plus the work, done now
+static long submit(void* aiocbp, enum op op)
+{
+	struct xnu_aiocb cb;
+	struct request* r;
+	long result;
+	int error;
+
+	if (aiocbp == NULL)
+		return -EFAULT;
+	cb = *(const struct xnu_aiocb*) aiocbp;
+	error = request_check(&cb, op);
+	if (error != 0)
+		return -error;
+	r = request_reserve(aiocbp, cb.aio_fildes);
+	if (r == NULL)
+		return -EAGAIN;
+
+	error = perform(&cb, op, &result);
+	request_complete(r, error, result);
+	notify(&cb.aio_sigevent);
+	return 0;
+}
+
+long sys_aio_read(void* aiocbp)
+{
+	return submit(aiocbp, OP_READ);
+}
+
+long sys_aio_write(void* aiocbp)
+{
+	return submit(aiocbp, OP_WRITE);
+}
+
+long sys_aio_fsync(int op, void* aiocbp)
+{
+	if (op == XNU_O_SYNC || op == 0)
+		return submit(aiocbp, OP_FSYNC);
+	if (op == XNU_O_DSYNC)
+		return submit(aiocbp, OP_DSYNC);
+	return -EINVAL;
+}
+
+// The first request for aiocbp (XNU keeps a done queue in completion order; ours completes in submission order)
+static struct request* request_find_locked(const void* aiocbp)
+{
+	for (int i = 0; i < AIO_PROCESS_MAX; i++)
+		if (requests[i].aiocbp != NULL && requests[i].aiocbp == aiocbp)
+			return &requests[i];
+	return NULL;
+}
+
+long sys_aio_error(void* aiocbp)
+{
+	long ret = -EINVAL;
+	unsigned long long mask = sigsafe_lock(&aio_lock);
+	struct request* r = aiocbp != NULL ? request_find_locked(aiocbp) : NULL;
+	if (r != NULL)
+		ret = r->done ? r->error : EINPROGRESS;
+	sigsafe_unlock(&aio_lock, mask);
+	return ret;
+}
+
+long sys_aio_return(void* aiocbp)
+{
+	long ret = -EINVAL;
+	unsigned long long mask = sigsafe_lock(&aio_lock);
+	struct request* r = aiocbp != NULL ? request_find_locked(aiocbp) : NULL;
+	if (r != NULL)
+	{
+		if (r->done)
+		{
+			ret = r->result;
+			r->aiocbp = NULL;
+			nrequests--;
+		}
+		else
+			ret = -EINPROGRESS;
+	}
+	sigsafe_unlock(&aio_lock, mask);
+	return ret;
+}
+
+long sys_aio_cancel(int fd, void* aiocbp)
+{
+	long ret;
+	unsigned long long mask;
+
+	if (aiocbp != NULL && ((const struct xnu_aiocb*) aiocbp)->aio_fildes != fd)
+		return -EBADF;
+
+	mask = sigsafe_lock(&aio_lock);
+	if (nrequests == 0)
+		ret = XNU_AIO_ALLDONE;
+	else
+	{
+		ret = -EBADF; // do_aio_cancel_locked found nothing
+		for (int i = 0; i < AIO_PROCESS_MAX; i++)
+		{
+			const struct request* r = &requests[i];
+			if (r->aiocbp == NULL || (aiocbp != NULL ? r->aiocbp != aiocbp : r->fd != fd))
+				continue;
+			// a request still being performed by its submitter can't be cancelled (AIO_NOTCANCELED on XNU,
+			// but the caller's aiocb is done the moment the submitter returns): report it done like the rest
+			ret = XNU_AIO_ALLDONE;
+			break;
+		}
+	}
+	sigsafe_unlock(&aio_lock, mask);
+	return ret;
+}
+
+// Whether a request in the list is done; -1 when the process has no requests at all (EINVAL on XNU)
+static int any_done(void* const* list, int nent)
+{
+	int ret = 0;
+	unsigned long long mask = sigsafe_lock(&aio_lock);
+	if (nrequests == 0)
+		ret = -1;
+	for (int i = 0; i < nent && ret == 0; i++)
+	{
+		if (list[i] == NULL)
+			continue;
+		for (int k = 0; k < AIO_PROCESS_MAX; k++)
+		{
+			if (requests[k].aiocbp == list[i] && requests[k].done)
+			{
+				ret = 1;
+				break;
+			}
+		}
+	}
+	sigsafe_unlock(&aio_lock, mask);
+	return ret;
+}
+
+struct xnu_timespec
+{
+	long tv_sec;
+	long tv_nsec;
+};
+
+static long aio_suspend_common(void* const* list, int nent, const void* timeoutp, int cancelable)
+{
+	long long left_ns = -1; // no timeout
+	long long step_ns = 1000000;
+
+	if (nent < 1 || nent > AIO_PROCESS_MAX)
+		return -EINVAL;
+	if (timeoutp != NULL)
+	{
+		const struct xnu_timespec* ts = timeoutp;
+		if (ts->tv_sec < 0 || ts->tv_nsec < 0 || ts->tv_nsec >= 1000000000)
+			return -EINVAL;
+		left_ns = (long long) ts->tv_sec * 1000000000LL + ts->tv_nsec;
+	}
+
+	for (;;)
+	{
+		unsigned int seen = __atomic_load_n(&completions, __ATOMIC_ACQUIRE);
+		int done = any_done(list, nent);
+		if (done < 0)
+			return -EINVAL;
+		if (done > 0)
+			return 0;
+		if (left_ns == 0)
+			return -EAGAIN;
+
+		// Nothing listed is done: only another thread's submission can change that. Sleep a little (to the
+		// timeout at most), 1 ms first, backing off to 50 ms; a signal ends the wait with EINTR as on XNU.
+		long long sleep_ns = step_ns;
+		if (left_ns >= 0 && sleep_ns > left_ns)
+			sleep_ns = left_ns;
+		if (__atomic_load_n(&completions, __ATOMIC_ACQUIRE) != seen)
+			continue;
+		struct xnu_timespec req = { sleep_ns / 1000000000LL, sleep_ns % 1000000000LL };
+		long ret = LINUX_SYSCALL_C(cancelable, __NR_nanosleep, &req, NULL);
+		if (ret == -LINUX_EINTR)
+			return -EINTR;
+		if (left_ns > 0)
+			left_ns -= sleep_ns;
+		if (step_ns < 50000000)
+			step_ns *= 2;
+	}
+}
+
+long sys_aio_suspend(void* const* aiocblist, int nent, const void* timeoutp)
+{
+	CANCELATION_POINT();
+	return aio_suspend_common(aiocblist, nent, timeoutp, 1);
+}
+
+long sys_aio_suspend_nocancel(void* const* aiocblist, int nent, const void* timeoutp)
+{
+	return aio_suspend_common(aiocblist, nent, timeoutp, 0);
+}
+
+long sys_lio_listio(int mode, void* const* aiocblist, int nent, const void* sigp)
+{
+	struct xnu_sigevent sev = { XNU_SIGEV_NONE };
+	struct xnu_aiocb cbs[AIO_LISTIO_MAX];
+	void* ptrs[AIO_LISTIO_MAX];
+	struct request* reqs[AIO_LISTIO_MAX];
+	int count = 0;
+	long ret = 0;
+
+	if (mode != XNU_LIO_NOWAIT && mode != XNU_LIO_WAIT)
+		return -EINVAL;
+	if (nent < 1 || nent > AIO_LISTIO_MAX)
+		return -EINVAL;
+	if (sigp != NULL)
+	{
+		sev = *(const struct xnu_sigevent*) sigp;
+		if (!sigev_valid(&sev))
+			return -EINVAL;
+	}
+	if (aiocblist == NULL)
+		return -EFAULT;
+
+	// check every entry first: an invalid one fails the call with its errno, nothing submitted (macOS 27)
+	for (int i = 0; i < nent; i++)
+	{
+		if (aiocblist[i] == NULL)
+			continue;
+		cbs[count] = *(const struct xnu_aiocb*) aiocblist[i];
+		int opcode = cbs[count].aio_lio_opcode;
+		if (opcode != XNU_LIO_NOP && opcode != XNU_LIO_READ && opcode != XNU_LIO_WRITE)
+			return -EINVAL;
+		int error = request_check(&cbs[count], lio_op(opcode));
+		if (error != 0)
+			return -error;
+		ptrs[count] = aiocblist[i];
+		count++;
+	}
+	if (count == 0)
+		return 0;
+
+	// submit what fits (XNU enqueues each it can and returns EAGAIN if one didn't)
+	for (int i = 0; i < count; i++)
+	{
+		reqs[i] = request_reserve(ptrs[i], cbs[i].aio_fildes);
+		if (reqs[i] == NULL)
+			ret = -EAGAIN;
+	}
+
+	const struct xnu_sigevent* last_sev = NULL;
+	for (int i = 0; i < count; i++)
+	{
+		if (reqs[i] == NULL)
+			continue;
+		long result;
+		int error = perform(&cbs[i], lio_op(cbs[i].aio_lio_opcode), &result);
+		request_complete(reqs[i], error, result);
+		// LIO_NOWAIT: the call's sigevent replaces each entry's; LIO_WAIT: entries keep their own. Either way
+		// only the last completion of the group signals.
+		last_sev = mode == XNU_LIO_NOWAIT ? &sev : &cbs[i].aio_sigevent;
+	}
+	if (last_sev != NULL)
+		notify(last_sev);
+
+	return ret;
+}
