+		fsgetpath_docid_drop(vc.dfd, vc.path, &d2, &d1);
+		fsgetpath_docid_drop(vc2.dfd, vc2.path, &d1, &d2);
+		fsgetpath_docid_done(vc.dfd, vc.path, &d1);
+	}
