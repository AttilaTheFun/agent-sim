+// interrupt_enter took the outer handler's reply, and darlingserver dropped it when pushed back; the next ones nested
+// deeper, until the signal stack overflowed (SIGSEGV). (A second suspend could nest the same way.)
 #define dserver_rpc_hooks_atomic_save_t linux_sigset_t
 
 static void dserver_rpc_hooks_atomic_begin(dserver_rpc_hooks_atomic_save_t* atomic_save) {
diff --git a/darling/src/libsystem_kernel/emulation/include/other/mach/foreign_hook.h b/darling/src/libsystem_kernel/emulation/include/other/mach/foreign_hook.h
new file mode 100644
index 00000000..a653c04b
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/other/mach/foreign_hook.h
@@ -0,0 +1,34 @@
+#ifndef _DARLING_EMULATION_FOREIGN_HOOK_H_
+#define _DARLING_EMULATION_FOREIGN_HOOK_H_
+
+// Hooks that Darling's libSystem provides by overriding weak symbols in
+// libsystem_kernel must be looked up by name when running on a foreign
+// libSystem (the iOS simulator runtime's); see darling_foreign_hook() in lkm.c.
+//
+// FOREIGN_HOOK(type, var, name) declares a pointer `var` of `type`, resolved
+// once; it is NULL on Darling's own libSystem and in dyld.
+
+#ifndef VARIANT_DYLD
+
+void* darling_foreign_hook(const char* name);
+
+// Set in the child of posix_spawn between fork and exec: the hooks (libkqueue_sim)
+// take locks other parent threads may have held at fork time, so they are skipped.
+extern int darling_in_spawn_child;
+
+#define FOREIGN_HOOK(type, var, name) \
+	static __typeof__(type) var##_cached; \
+	static int var##_resolved; \
+	if (!var##_resolved) { \
+		var##_cached = (__typeof__(type)) darling_foreign_hook(name); \
+		var##_resolved = 1; \
+	} \
+	__typeof__(type) var = darling_in_spawn_child ? (__typeof__(type)) 0 : var##_cached
+
+#else
+
+#define FOREIGN_HOOK(type, var, name) __typeof__(type) var = (__typeof__(type)) 0
+
+#endif
+
+#endif
diff --git a/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/misc/bsdflags.h b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/misc/bsdflags.h
new file mode 100644
index 00000000..77010f39
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/helper/misc/bsdflags.h
@@ -0,0 +1,82 @@
+#ifndef X86SIM_BSDFLAGS_H
+#define X86SIM_BSDFLAGS_H
+// x86Sim: BSD file flags (chflags: UF_TRACKED, UF_HIDDEN, ...) kept in the Linux extended attribute
+// "user.x86sim.bsdflags" (a little-endian u32; absent = 0), and reported as st_flags by stat and ATTR_CMN_FLAGS by
+// getattrlist. Linux has no such flags (its FS_IOC_SETFLAGS ones are different and mostly need root). Darling's
+// chflags/fchflags failed with ENOTSUP, and APFS's FSIOC_CAS_BSDFLAGS fsctl was missing: FileProvider's libfssync
+// sets UF_TRACKED on every item of the On My iPhone storage and trapped ("call to block failed with -1"), so Files
+// could open no document. Nothing acts on a flag (UF_IMMUTABLE doesn't stop writes); they are bookkeeping, as on a
+// file system that stores but doesn't enforce them. Symlinks can't have user xattrs on Linux: their flags are 0.
+// The attribute is hidden from listxattr (xattr_utils.h).
+#include <stdint.h>
+#include <darling/emulation/common/simple.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+
+#define X86SIM_BSDFLAGS_XATTR "user.x86sim.bsdflags"
+
+// Linux path of fd (works for O_PATH descriptors too), in buf (>= 32 bytes)
+static inline const char* x86sim_fd_path(int fd, char* buf)
+{
+	__simple_sprintf(buf, "/proc/self/fd/%d", fd);
+	return buf;
+}
+
+static inline uint32_t x86sim_bsdflags_get(const char* lpath, int nofollow)
+{
+	uint32_t v = 0;
+	long r = LINUX_SYSCALL(nofollow ? __NR_lgetxattr : __NR_getxattr, lpath, X86SIM_BSDFLAGS_XATTR, &v, sizeof(v));
+	return r == sizeof(v) ? v : 0;
+}
+
+// path relative to dfd (Linux AT_FDCWD = -100 or a descriptor), as fstatat takes it
+static inline uint32_t x86sim_bsdflags_get_at(int dfd, const char* path, int nofollow)
+{
+	if (path[0] == '/' || dfd == -100)
+		return x86sim_bsdflags_get(path, nofollow);
+	char buf[1100];
+	__simple_snprintf(buf, sizeof(buf), "/proc/self/fd/%d/%s", dfd, path);
+	return x86sim_bsdflags_get(buf, nofollow);
+}
+
+static inline uint32_t x86sim_bsdflags_get_fd(int fd)
+{
+	char buf[32];
+	return x86sim_bsdflags_get(x86sim_fd_path(fd, buf), 0);
+}
+
+// returns 0 or a negative Linux errno
+static inline long x86sim_bsdflags_set(const char* lpath, uint32_t v)
+{
+	if (v == 0)
+	{
+		long r = LINUX_SYSCALL(__NR_removexattr, lpath, X86SIM_BSDFLAGS_XATTR);
+		return (r == 0 || r == -61 /* ENODATA */) ? 0 : r;
+	}
+	return LINUX_SYSCALL(__NR_setxattr, lpath, X86SIM_BSDFLAGS_XATTR, &v, sizeof(v), 0);
+}
+
+// fsctl.c: the lock FSIOC_CAS_BSDFLAGS (and other read-modify-writes of the flags) take, -1 if none
+int x86sim_bsdflags_lock(void);
+void x86sim_bsdflags_unlock(int fd);
+
+// x86Sim: a UF_TRACKED item's document id. APFS keeps it with the document: a tracked file replaced by a rename over
+// it (a safe save, or FileProvider putting a downloaded file in place) or exchanged with RENAME_SWAP hands its id to
+// the file now at its path. Ours starts as the inode number's low 32 bits; an id handed over this way is kept in the
+// extended attribute "user.x86sim.docid" (a u32) of the file that took it (renameat.c). Without the hand-over the id
+// fileproviderd knew a materialized file by stopped resolving ("lookup of docID(...) timed out ... item is stale",
+// "ESTALE: opened wrong doc_id in _validate_file_openbyid"): it fetched the file from the extension again and left it
+// with a 1970 modification date.
+#define X86SIM_DOCID_XATTR "user.x86sim.docid"
+// nofollow: lpath's last component is the item itself (not a /proc/self/fd/N link to it)
+static inline uint32_t x86sim_docid_get(const char* lpath, unsigned long long ino, uint32_t flags, int nofollow)
+{
+	if (!(flags & 0x40 /* UF_TRACKED */))
+		return 0;
+	uint32_t v = 0;
+	long r = LINUX_SYSCALL(nofollow ? __NR_lgetxattr : __NR_getxattr, lpath, X86SIM_DOCID_XATTR, &v, sizeof(v));
+	if (r == sizeof(v) && v)
+		return v;
+	return (uint32_t) ino ? (uint32_t) ino : 1;
+}
+
+#endif
