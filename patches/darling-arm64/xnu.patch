diff --git a/darling/tests/host/iflist2.c b/darling/tests/host/iflist2.c
new file mode 100644
index 00000000..73e2dfd7
--- /dev/null
+++ b/darling/tests/host/iflist2.c
@@ -0,0 +1,125 @@
+// sysctl net.route.0.<af>.NET_RT_IFLIST2.<index> through sysctl_net.c and ifinfo.c, against Linux's rtnetlink:
+// RTM_IFINFO2 (if_msghdr2 + sockaddr_dl) per interface with if_data64 counters, then its RTM_NEWADDRs, as XNU's
+// sysctl_iflist2(). Built with Darling's headers.
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <net/if.h>
+#include <net/if_dl.h>
+#include <net/if_types.h>
+#include <net/route.h>
+#include <darling/emulation/xnu_syscall/bsd/helper/misc/sysctl_net.h>
+#include "check.h"
+
+void* malloc(unsigned long);
+int memcmp(const void*, const void*, unsigned long);
+unsigned long long host_sysfs(const char* ifname, const char* file);
+unsigned int host_if_index(const char* ifname);
+void host_lo_traffic(int count);
+
+#define ROUNDUP32(a) ((a) > 0 ? (1 + (((a) - 1) | (sizeof(uint32_t) - 1))) : sizeof(uint32_t))
+
+static long route_sysctl(int op, int index, void* old, unsigned long* len)
+{
+	int name[6] = { CTL_NET, PF_ROUTE, 0, 0, op, index };
+	return sysctls_net[0].handler(name, 6, old, len, 0, 0);
+}
+
+struct walk {
+	int links, addrs, other, bad_len, bad_sdl;
+	struct if_msghdr2* lo;
+};
+
+static void walk(char* buf, unsigned long len, int v2, struct walk* w)
+{
+	for (char* p = buf; p < buf + len; ) {
+		struct if_msghdr* ifm = (void*) p;
+		if (ifm->ifm_msglen == 0)
+			break;
+		if (ifm->ifm_type == (v2 ? RTM_IFINFO2 : RTM_IFINFO)) {
+			unsigned long hdr = v2 ? sizeof(struct if_msghdr2) : sizeof(struct if_msghdr);
+			struct sockaddr_dl* sdl = (void*) (p + hdr);
+			w->links++;
+			if (ifm->ifm_msglen != hdr + ROUNDUP32(sdl->sdl_len) || ifm->ifm_version != RTM_VERSION)
+				w->bad_len++;
+			if (sdl->sdl_family != AF_LINK || sdl->sdl_index != ifm->ifm_index || !(ifm->ifm_addrs & RTA_IFP))
+				w->bad_sdl++;
+			if (v2 && sdl->sdl_nlen == 2 && memcmp(sdl->sdl_data, "lo", 2) == 0)
+				w->lo = (void*) p;
+		} else if (ifm->ifm_type == RTM_NEWADDR) {
+			w->addrs++;
+		} else {
+			w->other++;
+		}
+		p += ifm->ifm_msglen;
+	}
+}
+
+int main(void)
+{
+	unsigned long len = 0, len1 = 0;
+	long ret;
+
+	printf("sizeof(struct if_msghdr) %lu, sizeof(struct if_msghdr2) %lu\n",
+		(unsigned long) sizeof(struct if_msghdr), (unsigned long) sizeof(struct if_msghdr2));
+
+	ret = route_sysctl(NET_RT_IFLIST2, 0, 0, &len);
+	CHECK(ret == 0 && len > 0, "NET_RT_IFLIST2 size query: %ld, %lu bytes", ret, len);
+	if (ret != 0)
+		DONE();
+
+	unsigned long short_len = len - 1;
+	char* buf = malloc(len + 4096);
+	ret = route_sysctl(NET_RT_IFLIST2, 0, buf, &short_len);
+	CHECK(ret == -ENOMEM, "a buffer one byte short: -ENOMEM (%ld)", ret);
+
+	host_lo_traffic(8);
+	unsigned long long rx0 = host_sysfs("lo", "statistics/rx_packets"), rxb0 = host_sysfs("lo", "statistics/rx_bytes");
+	len += 4096;
+	ret = route_sysctl(NET_RT_IFLIST2, 0, buf, &len);
+	unsigned long long rx1 = host_sysfs("lo", "statistics/rx_packets"), rxb1 = host_sysfs("lo", "statistics/rx_bytes");
+	CHECK(ret == 0, "NET_RT_IFLIST2: %ld, %lu bytes", ret, len);
+
+	struct walk w = { 0 };
+	walk(buf, len, 1, &w);
+	CHECK(w.links > 0 && w.bad_len == 0 && w.bad_sdl == 0 && w.other == 0,
+		"%d RTM_IFINFO2 (%d bad length, %d bad sockaddr_dl), %d RTM_NEWADDR, %d other",
+		w.links, w.bad_len, w.bad_sdl, w.addrs, w.other);
+	CHECK(w.lo != 0, "lo is listed");
+	if (!w.lo)
+		DONE();
+
+	struct if_msghdr2* lo = w.lo;
+	CHECK(lo->ifm_index == host_if_index("lo"), "lo index %u (Linux %u)", lo->ifm_index, host_if_index("lo"));
+	CHECK(lo->ifm_data.ifi_type == IFT_LOOP && (lo->ifm_flags & IFF_LOOPBACK), "lo: IFT_LOOP, IFF_LOOPBACK");
+	CHECK(lo->ifm_data.ifi_mtu == host_sysfs("lo", "mtu"), "lo mtu %u", lo->ifm_data.ifi_mtu);
+	CHECK(lo->ifm_snd_maxlen == (int) host_sysfs("lo", "tx_queue_len"), "lo ifm_snd_maxlen %d = tx_queue_len",
+		lo->ifm_snd_maxlen);
+	CHECK(lo->ifm_data.ifi_ipackets > 0 && lo->ifm_data.ifi_ipackets >= rx0 && lo->ifm_data.ifi_ipackets <= rx1,
+		"lo ipackets %llu, Linux %llu..%llu", lo->ifm_data.ifi_ipackets, rx0, rx1);
+	CHECK(lo->ifm_data.ifi_ibytes >= rxb0 && lo->ifm_data.ifi_ibytes <= rxb1,
+		"lo ibytes %llu, Linux %llu..%llu", lo->ifm_data.ifi_ibytes, rxb0, rxb1);
+
+	// NET_RT_IFLIST lists the same, with the shorter header
+	ret = route_sysctl(NET_RT_IFLIST, 0, 0, &len1);
+	char* buf1 = malloc(len1 + 4096);
+	len1 += 4096;
+	ret = route_sysctl(NET_RT_IFLIST, 0, buf1, &len1);
+	struct walk w1 = { 0 };
+	walk(buf1, len1, 0, &w1);
+	CHECK(ret == 0 && w1.links == w.links && w1.addrs == w.addrs && w1.bad_len == 0
+		&& len - len1 == w.links * (sizeof(struct if_msghdr2) - sizeof(struct if_msghdr)),
+		"NET_RT_IFLIST: %d RTM_IFINFO, %d RTM_NEWADDR, %lu bytes", w1.links, w1.addrs, len1);
+
+	// one interface
+	len = 0;
+	route_sysctl(NET_RT_IFLIST2, lo->ifm_index, 0, &len);
+	char* one = malloc(len);
+	ret = route_sysctl(NET_RT_IFLIST2, lo->ifm_index, one, &len);
+	struct walk w2 = { 0 };
+	walk(one, len, 1, &w2);
+	CHECK(ret == 0 && w2.links == 1 && w2.lo != 0, "index %u: just lo (%d RTM_IFINFO2, %d RTM_NEWADDR)",
+		lo->ifm_index, w2.links, w2.addrs);
+	DONE();
+}
diff --git a/darling/tests/host/proc-stat.c b/darling/tests/host/proc-stat.c
new file mode 100644
index 00000000..d3c63bef
--- /dev/null
+++ b/darling/tests/host/proc-stat.c
@@ -0,0 +1,101 @@
+// sysctl_proc.c's /proc/<pid>/stat parsing: next_stat_elem()/skip_stat_elems() and load_proc()'s field walk, as
+// run.sh extracts them from the source (proc-stat-extract.h, load-proc-body.inc), with a stand-in kinfo_proc.
+// Linux prints comm raw between parentheses (fs/proc/array.c): it may hold spaces and ')' itself, so it ends at the
+// line's LAST ')'. Fields after tty_nr: tpgid flags minflt cminflt majflt cmajflt utime stime cutime cstime (10),
+// then priority and nice.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "check.h"
+
+#define SRUN 2
+#define SSLEEP 3
+#define SSTOP 4
+#define SZOMB 5
+#define P_CONTROLT 0x2
+#define KERN_PROC_SESSION 3
+#define __simple_atoi(s, end) atoi(s)
+#define darling_proc_name(pid, comm, dst, len) 0
+
+struct kinfo_proc_chain {
+	struct {
+		struct { char p_comm[17]; int p_pid, p_stat, p_flag, p_priority, p_nice; } kp_proc;
+		struct { int e_ppid, e_pgid, e_tdev; } kp_eproc;
+	} kinfo;
+};
+
+#include "proc-stat-extract.h"
+
+static int load(const char* line, struct kinfo_proc_chain* kinfo)
+{
+	static char stat[1024];
+	char* statptr;
+	const char* elem;
+	int what = 0, flag = 0;
+
+	memset(kinfo, 0, sizeof(*kinfo));
+	strcpy(stat, line);
+#include "load-proc-body.inc"
+	return 0;
+retnull:
+	return -1;
+}
+
+int main(void)
+{
+	struct kinfo_proc_chain k;
+	setvbuf(stdout, NULL, _IONBF, 0); // the lines before an AddressSanitizer abort
+	const char* tail = " 4194560 11 0 0 0 5 3 0 0 21 -4 1 0 98765 1000 200";
+
+	char line[512];
+	snprintf(line, sizeof(line), "%s%s", "1234 (a) b (c)) S 1 1234 1234 34817 -1", tail);
+	int r = load(line, &k);
+	CHECK(r == 0, "comm with ') ' and '(': parsed (%d)", r);
+	CHECK(strcmp(k.kinfo.kp_proc.p_comm, "a) b (c)") == 0, "comm is \"a) b (c)\" (got \"%s\")", k.kinfo.kp_proc.p_comm);
+	CHECK(k.kinfo.kp_proc.p_stat == SSLEEP, "state S (got %d)", k.kinfo.kp_proc.p_stat);
+	CHECK(k.kinfo.kp_eproc.e_ppid == 1, "ppid 1 (got %d)", k.kinfo.kp_eproc.e_ppid);
+	CHECK(k.kinfo.kp_eproc.e_tdev == 34817, "tty_nr 34817 (got %d)", k.kinfo.kp_eproc.e_tdev);
+	CHECK(k.kinfo.kp_proc.p_priority == 21, "priority 21, field 18 (got %d)", k.kinfo.kp_proc.p_priority);
+	CHECK(k.kinfo.kp_proc.p_nice == -4, "nice -4, field 19 (got %d)", k.kinfo.kp_proc.p_nice);
+
+	snprintf(line, sizeof(line), "%s%s", "77 (plain) R 5 77 77 0 -1", tail);
+	r = load(line, &k);
+	CHECK(r == 0 && strcmp(k.kinfo.kp_proc.p_comm, "plain") == 0 && k.kinfo.kp_proc.p_stat == SRUN
+		&& k.kinfo.kp_eproc.e_ppid == 5 && k.kinfo.kp_proc.p_priority == 21,
+		"plain comm: comm %s state %d ppid %d priority %d", k.kinfo.kp_proc.p_comm, k.kinfo.kp_proc.p_stat,
+		k.kinfo.kp_eproc.e_ppid, k.kinfo.kp_proc.p_priority);
+
+	snprintf(line, sizeof(line), "%s%s", "9 (a-name-longer-than-16) R 5 9 9 0 -1", tail);
+	load(line, &k);
+	CHECK(memchr(k.kinfo.kp_proc.p_comm, 0, sizeof(k.kinfo.kp_proc.p_comm)) != NULL,
+		"long comm: p_comm NUL-terminated (\"%.17s\")", k.kinfo.kp_proc.p_comm);
+
+	// the end of the line: the last field, then NULL, never past the NUL
+	{
+		char buf[] = "1 (x) Z";
+		char* p = buf;
+		const char *a = next_stat_elem(&p), *b = next_stat_elem(&p), *c = next_stat_elem(&p);
+		const char* d = next_stat_elem(&p);
+		CHECK(a && b && c && !strcmp(a, "1") && !strcmp(b, "x") && !strcmp(c, "Z") && d == NULL && p <= buf + 7,
+			"\"1 (x) Z\": 1, x, Z, then NULL at the end");
+	}
+	{
+		char buf[] = "1 (x)";
+		char* p = buf;
+		next_stat_elem(&p);
+		const char* b = next_stat_elem(&p);
+		const char* c = next_stat_elem(&p);
+		CHECK(b && !strcmp(b, "x") && c == NULL && p <= buf + 5, "\"1 (x)\" (comm last): x, then NULL");
+	}
+	{
+		// heap, exact size, so AddressSanitizer catches a read past the NUL
+		char* buf = strdup("1 (unterminated");
+		char* p = buf;
+		next_stat_elem(&p);
+		const char* b = next_stat_elem(&p);
+		const char* c = b ? NULL : next_stat_elem(&p);
+		CHECK(b == NULL && c == NULL && p <= buf + strlen("1 (unterminated"), "comm without ')': NULL, not past the NUL");
+		free(buf);
+	}
+	DONE();
+}
diff --git a/darling/tests/host/rlimit.c b/darling/tests/host/rlimit.c
new file mode 100644
index 00000000..3f5a91d1
--- /dev/null
+++ b/darling/tests/host/rlimit.c
@@ -0,0 +1,74 @@
+// getrlimit.c / setrlimit.c against a fake prlimit64 (shim.c): Darwin's RLIM_INFINITY is 2^63 - 1
+// (bsd/sys/resource.h), Linux's ~0. Built with Darling's headers.
+#include <darling/emulation/conversion/misc/getrlimit.h>
+#include "check.h"
+
+long sys_getrlimit(unsigned int which, struct xnu_rlimit* rlp);
+long sys_setrlimit(unsigned int which, const struct xnu_rlimit* rlp);
+
+extern int fake_prlimit, fake_prlimit_sets;
+extern unsigned long long fake_limits[16][2];
+
+#define DARWIN_INF 0x7fffffffffffffffULL
+#define LINUX_INF (~0ULL)
+
+int main(void)
+{
+	struct xnu_rlimit r;
+	long ret;
+
+	fake_prlimit = 1;
+	fake_limits[LINUX_RLIMIT_STACK][0] = 8 << 20;
+	fake_limits[LINUX_RLIMIT_STACK][1] = LINUX_INF;
+	fake_limits[LINUX_RLIMIT_CPU][0] = LINUX_INF;
+	fake_limits[LINUX_RLIMIT_CPU][1] = LINUX_INF;
+	fake_limits[LINUX_RLIMIT_NOFILE][0] = 1024;
+	fake_limits[LINUX_RLIMIT_NOFILE][1] = 524288;
+	fake_limits[LINUX_RLIMIT_CORE][0] = 0;
+	fake_limits[LINUX_RLIMIT_CORE][1] = LINUX_INF;
+
+	ret = sys_getrlimit(BSD_RLIMIT_STACK, &r);
+	CHECK(ret == 0 && r.rlim_cur == 8 << 20 && r.rlim_max == DARWIN_INF,
+		"getrlimit(STACK) {8M, unlimited} -> {%#llx, %#llx}", r.rlim_cur, r.rlim_max);
+	ret = sys_getrlimit(BSD_RLIMIT_CPU | BSD_RLIMIT_POSIX, &r);
+	CHECK(ret == 0 && r.rlim_cur == DARWIN_INF && r.rlim_max == DARWIN_INF,
+		"getrlimit(CPU|POSIX) unlimited -> {%#llx, %#llx}", r.rlim_cur, r.rlim_max);
+	CHECK((long long) r.rlim_cur > 0, "unlimited is positive as int64_t (%lld)", (long long) r.rlim_cur);
+
+	struct xnu_rlimit set = { 4 << 20, DARWIN_INF };
+	ret = sys_setrlimit(BSD_RLIMIT_STACK, &set);
+	CHECK(ret == 0 && fake_limits[LINUX_RLIMIT_STACK][0] == 4 << 20 && fake_limits[LINUX_RLIMIT_STACK][1] == LINUX_INF,
+		"setrlimit(STACK, {4M, RLIM_INFINITY}) -> Linux {%#llx, %#llx}",
+		fake_limits[LINUX_RLIMIT_STACK][0], fake_limits[LINUX_RLIMIT_STACK][1]);
+
+	// what getrlimit said, handed back, changes nothing
+	sys_getrlimit(BSD_RLIMIT_CORE, &r);
+	sys_setrlimit(BSD_RLIMIT_CORE, &r);
+	CHECK(fake_limits[LINUX_RLIMIT_CORE][0] == 0 && fake_limits[LINUX_RLIMIT_CORE][1] == LINUX_INF,
+		"getrlimit/setrlimit round trip (CORE) keeps Linux {0, unlimited}: {%#llx, %#llx}",
+		fake_limits[LINUX_RLIMIT_CORE][0], fake_limits[LINUX_RLIMIT_CORE][1]);
+
+	// RLIMIT_NOFILE keeps x86Sim's one-descriptor reserve, and unlimited doesn't wrap
+	ret = sys_getrlimit(BSD_RLIMIT_NOFILE, &r);
+	CHECK(ret == 0 && r.rlim_cur == 1023 && r.rlim_max == 524287,
+		"getrlimit(NOFILE) {1024, 524288} -> {%llu, %llu}", r.rlim_cur, r.rlim_max);
+	set.rlim_cur = 2000;
+	set.rlim_max = DARWIN_INF;
+	ret = sys_setrlimit(BSD_RLIMIT_NOFILE, &set);
+	CHECK(fake_limits[LINUX_RLIMIT_NOFILE][0] == 2001 && fake_limits[LINUX_RLIMIT_NOFILE][1] == LINUX_INF,
+		"setrlimit(NOFILE, {2000, RLIM_INFINITY}) -> Linux {%llu, %#llx}",
+		fake_limits[LINUX_RLIMIT_NOFILE][0], fake_limits[LINUX_RLIMIT_NOFILE][1]);
+
+	int sets = fake_prlimit_sets;
+	set.rlim_cur = 100;
+	set.rlim_max = 200;
+	ret = sys_setrlimit(BSD_RLIMIT_NOFILE, &set);
+	CHECK(ret == 0 && fake_prlimit_sets == sets, "setrlimit(NOFILE) below the current limit: accepted, not applied");
+
+	set.rlim_cur = 1000;
+	set.rlim_max = 5000;
+	ret = sys_setrlimit(BSD_RLIMIT_DATA, &set);
+	CHECK(fake_limits[LINUX_RLIMIT_DATA][0] == 1000 && fake_limits[LINUX_RLIMIT_DATA][1] == 5000,
+		"finite limits pass through unchanged");
+	DONE();
+}
diff --git a/darling/tests/host/run.sh b/darling/tests/host/run.sh
new file mode 100755
index 00000000..3b55f12f
--- /dev/null
+++ b/darling/tests/host/run.sh
@@ -0,0 +1,122 @@
+#!/bin/sh
+# Host tests for libsystem_kernel emulation fixes. Each builds the emulation's own sources for Linux, with Darling's
+# headers (the flags libsystem_kernel builds with, minus the Darwin target) and shim.c standing in for what lies
+# outside the files under test, and runs them against the real Linux kernel. proc-stat builds the parsing code
+# extracted from sysctl_proc.c with the host's headers instead (load_proc() can't be built alone).
+#
+#   run.sh [rev] [test...]
+#
+# With a git revision (e.g. HEAD), that revision's emulation sources are tested instead of the working tree's: run
+# both to see a fix fail before and pass after. Builds go to $XNU_HOST_TEST_DIR (default ${TMPDIR:-/tmp}/xnu-host-
+# tests). Needs clang and Darling's SDK headers (external/darling/Developer/...), not a Darling build.
+
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+xnu=$(cd "$here/../../.." && pwd)
+darling=$(cd "$xnu/../../.." && pwd)
+CC=${CC:-clang}
+
+rev=
+if [ $# -gt 0 ] && git -C "$xnu" rev-parse -q --verify "$1^{commit}" >/dev/null 2>&1; then
+	rev=$1
+	shift
+fi
+tests=${*:-proc-stat rlimit symlinkat waitid iflist2}
+
+out=${XNU_HOST_TEST_DIR:-${TMPDIR:-/tmp}/xnu-host-tests}/${rev:-worktree}
+rm -rf "$out"
+mkdir -p "$out/inc/darling"
+if [ -n "$rev" ]; then
+	git -C "$xnu" archive "$rev" darling/src/libsystem_kernel/emulation | tar -x -C "$out"
+	emu=$out/darling/src/libsystem_kernel/emulation
+else
+	emu=$xnu/darling/src/libsystem_kernel/emulation
+fi
+ln -s "$emu/include" "$out/inc/darling/emulation"
+src=$emu/src
+
+sdk=Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include
+DFLAGS="-nostdinc -DDARLING -DDARWIN -D_DARWIN_C_SOURCE -D_POSIX_C_SOURCE -D__APPLE__ -D__APPLE_CC__=6000 -D__MACH__ \
+	-I$here -I$here/shim-include -I$out/inc -I$darling/build/src/include -I$darling/src/include \
+	-I$darling/basic-headers -I$darling/$sdk -I$darling/build/$sdk -I$xnu/darling/src/libsystem_kernel \
+	-isystem $($CC -print-resource-dir)/include -Ulinux -Wno-error=implicit-function-declaration \
+	-Wno-error=int-conversion -std=gnu99 -fno-builtin -fno-stack-protector -w -O1 -g"
+
+# darling_cc <output.o> <source.c>: a source built as libsystem_kernel builds it, for Linux
+darling_cc() {
+	$CC $DFLAGS -c "$2" -o "$1"
+}
+
+build_proc_stat() {
+	f=$src/xnu_syscall/bsd/helper/misc/sysctl_proc.c
+	awk '/^const char\* next_stat_elem\(char\*\* buf\)/,0' "$f" | awk '{print} /^}/ {n++} n==2 {exit}' \
+		>"$out/proc-stat-extract.h"
+	awk '/^static struct kinfo_proc_chain\* load_proc\(/ {in_fn=1}
+		in_fn && /statptr = stat;/ {p=1}
+		p {print}
+		p && /p_nice = / {exit}' "$f" >"$out/load-proc-body.inc"
+	$CC -g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-int-conversion -I"$out" -I"$here" \
+		"$here/proc-stat.c" -o "$out/proc-stat"
+}
+
+build_rlimit() {
+	darling_cc "$out/rlimit.o" "$here/rlimit.c" &&
+	darling_cc "$out/getrlimit.o" "$src/xnu_syscall/bsd/impl/misc/getrlimit.c" &&
+	darling_cc "$out/setrlimit.o" "$src/xnu_syscall/bsd/impl/misc/setrlimit.c" &&
+	$CC -o "$out/rlimit" "$out/rlimit.o" "$out/getrlimit.o" "$out/setrlimit.o" "$out/errno.o" "$out/shim.o"
+}
+
+build_symlinkat() {
+	darling_cc "$out/symlinkat-test.o" "$here/symlinkat.c" &&
+	darling_cc "$out/symlinkat.o" "$src/xnu_syscall/bsd/impl/unistd/symlinkat.c" &&
+	darling_cc "$out/common_at.o" "$src/xnu_syscall/bsd/helper/misc/common_at.c" &&
+	$CC -o "$out/symlinkat" "$out/symlinkat-test.o" "$out/symlinkat.o" "$out/common_at.o" "$out/errno.o" \
+		"$out/shim.o"
+}
+
+build_waitid() {
+	darling_cc "$out/waitid-test.o" "$here/waitid.c" &&
+	darling_cc "$out/waitid.o" "$src/xnu_syscall/bsd/impl/process/waitid.c" &&
+	darling_cc "$out/wait4conv.o" "$src/conversion/process/wait4.c" &&
+	darling_cc "$out/duct_signals.o" "$src/conversion/signal/duct_signals.c" &&
+	darling_cc "$out/table.o" "$src/xnu_syscall/bsd/bsd_syscall_table.c" || return 1
+	# every other syscall in the table: an empty stand-in
+	objs="$out/waitid-test.o $out/waitid.o $out/wait4conv.o $out/duct_signals.o $out/table.o $out/errno.o $out/shim.o"
+	nm --defined-only -j $objs 2>/dev/null | sort -u >"$out/defined"
+	nm -u -j "$out/table.o" | sort -u | comm -23 - "$out/defined" | sed 's/.*/void &(void) {}/' >"$out/stubs.c"
+	$CC -c "$out/stubs.c" -o "$out/stubs.o" &&
+	$CC -o "$out/waitid" $objs "$out/stubs.o"
+}
+
+build_iflist2() {
+	darling_cc "$out/iflist2.o" "$here/iflist2.c" &&
+	darling_cc "$out/sysctl_net.o" "$src/xnu_syscall/bsd/helper/misc/sysctl_net.c" &&
+	darling_cc "$out/ifinfo.o" "$src/xnu_syscall/bsd/helper/network/ifinfo.c" &&
+	darling_cc "$out/rtnetlink.o" "$src/xnu_syscall/bsd/helper/network/rtnetlink.c" &&
+	$CC -o "$out/iflist2" "$out/iflist2.o" "$out/sysctl_net.o" "$out/ifinfo.o" "$out/rtnetlink.o" "$out/errno.o" \
+		"$out/shim.o"
+}
+
+$CC -g -O1 -c "$here/shim.c" -o "$out/shim.o" || exit 2
+darling_cc "$out/errno.o" "$src/conversion/errno.c" || exit 2
+
+failed=0
+for t in $tests; do
+	echo "== $t (${rev:-working tree})"
+	fn=build_$(echo "$t" | tr - _)
+	if ! $fn >"$out/$t.build.log" 2>&1; then
+		echo "FAIL $t: build"
+		sed 's/^/    /' "$out/$t.build.log" | head -20
+		failed=1
+		continue
+	fi
+	case $t in
+		symlinkat) set -- "$out/symlinkat-dirs" ;;
+		*) set -- ;;
+	esac
+	"$out/$t" "$@" 2>&1
+	status=$?
+	echo "-- $t: exit $status"
+	[ $status -eq 0 ] || failed=1
+done
+exit $failed
diff --git a/darling/tests/host/shim-include/darling/emulation/common/bsdthread/per_thread_wd.h b/darling/tests/host/shim-include/darling/emulation/common/bsdthread/per_thread_wd.h
new file mode 100644
index 00000000..baee3d05
--- /dev/null
+++ b/darling/tests/host/shim-include/darling/emulation/common/bsdthread/per_thread_wd.h
@@ -0,0 +1,10 @@
+// Host-test stand-in: the real one reads the working directory from Darwin TSD (%gs), which Linux doesn't have.
+// shim.c's get_perthread_wd() returns the directory the test chose.
+#ifndef _PER_THREAD_WD_H
+#define _PER_THREAD_WD_H
+
+#include <darling/emulation/conversion/common_at.h>
+
+int get_perthread_wd(void);
+
+#endif
diff --git a/darling/tests/host/shim.c b/darling/tests/host/shim.c
new file mode 100644
index 00000000..b8efba9e
--- /dev/null
+++ b/darling/tests/host/shim.c
@@ -0,0 +1,134 @@
+// Linux-side stand-ins for what the emulation sources call outside the files under test, plus host helpers the
+// tests (built with Darling's headers) can't write themselves. Built with the host's own headers.
+#define _GNU_SOURCE
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+// prlimit64 answered from a table instead of the kernel, when a test turns it on
+int fake_prlimit;
+unsigned long long fake_limits[16][2];
+int fake_prlimit_sets;
+
+long linux_syscall(long a1, long a2, long a3, long a4, long a5, long a6, int nr)
+{
+	if (fake_prlimit && nr == SYS_prlimit64) {
+		unsigned int which = a2;
+		unsigned long long* new = (void*) a3;
+		unsigned long long* old = (void*) a4;
+		if (which >= 16)
+			return -EINVAL;
+		if (old) {
+			old[0] = fake_limits[which][0];
+			old[1] = fake_limits[which][1];
+		}
+		if (new) {
+			fake_limits[which][0] = new[0];
+			fake_limits[which][1] = new[1];
+			fake_prlimit_sets++;
+		}
+		return 0;
+	}
+	long ret = syscall(nr, a1, a2, a3, a4, a5, a6);
+	return ret < 0 ? -errno : ret;
+}
+
+// common/bsdthread/per_thread_wd.h (see shim-include)
+int shim_perthread_wd = AT_FDCWD;
+int get_perthread_wd(void) { return shim_perthread_wd; }
+
+// vchroot_expand: there's no prefix here; the path and its base directory stay as given
+int vchroot_expand(void* args) { (void) args; return 0; }
+
+// bsdthread/pthread_canceled: never canceled
+long sys_pthread_canceled(int action) { (void) action; return -EINVAL; }
+
+// route.h (sysctl_net.c's NET_RT_DUMP): not under test
+int route_dump(int af, void* old, unsigned long* oldlen) { (void) af; (void) old; (void) oldlen; return -ENOSYS; }
+
+// ---- host helpers
+
+int host_mkdirs(const char* base, int* wd_fd, int* dir_fd)
+{
+	char a[4096], b[4096];
+	snprintf(a, sizeof(a), "%s/wd", base);
+	snprintf(b, sizeof(b), "%s/dirfd", base);
+	mkdir(base, 0755);
+	mkdir(a, 0755);
+	mkdir(b, 0755);
+	*wd_fd = open(a, O_RDONLY | O_DIRECTORY);
+	*dir_fd = open(b, O_RDONLY | O_DIRECTORY);
+	return *wd_fd >= 0 && *dir_fd >= 0 ? 0 : -1;
+}
+
+// the symlink's target, or "" if there's no symlink at base/sub/name
+const char* host_readlink(const char* base, const char* sub, const char* name)
+{
+	static char target[4096];
+	char path[4096];
+	snprintf(path, sizeof(path), "%s/%s/%s", base, sub, name);
+	ssize_t n = readlink(path, target, sizeof(target) - 1);
+	target[n > 0 ? n : 0] = 0;
+	return target;
+}
+
+// a child that exits 42 once gate is closed
+int host_spawn_gated(int* gate)
+{
+	int p[2];
+	if (pipe(p))
+		return -1;
+	pid_t pid = fork();
+	if (pid == 0) {
+		char c;
+		close(p[1]);
+		read(p[0], &c, 1);
+		_exit(42);
+	}
+	close(p[0]);
+	*gate = p[1];
+	return pid;
+}
+
+void host_release(int gate) { close(gate); }
+
+int host_sigchld(void) { return SIGCHLD; }
+
+unsigned long long host_sysfs(const char* ifname, const char* file)
+{
+	char path[256];
+	unsigned long long v = 0;
+	snprintf(path, sizeof(path), "/sys/class/net/%s/%s", ifname, file);
+	FILE* f = fopen(path, "r");
+	if (!f)
+		return ~0ULL;
+	if (fscanf(f, "%llu", &v) != 1)
+		v = ~0ULL;
+	fclose(f);
+	return v;
+}
+
+unsigned int host_if_index(const char* ifname) { return if_nametoindex(ifname); }
+
+// some packets over the loopback, so its counters aren't all zero
+void host_lo_traffic(int count)
+{
+	int s = socket(AF_INET, SOCK_DGRAM, 0);
+	struct sockaddr_in sin = { .sin_family = AF_INET, .sin_addr.s_addr = htonl(INADDR_LOOPBACK) };
+	socklen_t len = sizeof(sin);
+	bind(s, (void*) &sin, sizeof(sin));
+	getsockname(s, (void*) &sin, &len);
+	for (int i = 0; i < count; i++)
+		sendto(s, "x", 1, 0, (void*) &sin, sizeof(sin));
+	close(s);
+}
diff --git a/darling/tests/host/symlinkat.c b/darling/tests/host/symlinkat.c
new file mode 100644
index 00000000..bf34b7de
--- /dev/null
+++ b/darling/tests/host/symlinkat.c
@@ -0,0 +1,28 @@
+// symlinkat.c (and common_at.c's atfd()) on Linux: the link is created relative to the directory fd the caller
+// passed, and relative to the thread's working directory only for AT_FDCWD. Built with Darling's headers.
+#include <darling/emulation/conversion/common_at.h>
+#include "check.h"
+
+long sys_symlinkat(const char* path, int fd, const char* link);
+int host_mkdirs(const char* base, int* wd_fd, int* dir_fd);
+const char* host_readlink(const char* base, const char* sub, const char* name);
+extern int shim_perthread_wd;
+int strcmp(const char*, const char*);
+
+int main(int argc, char** argv)
+{
+	int wd, dir;
+	if (argc < 2 || host_mkdirs(argv[1], &wd, &dir) < 0)
+		return 2;
+	shim_perthread_wd = wd;
+
+	long ret = sys_symlinkat("target-1", dir, "link-1");
+	CHECK(ret == 0, "symlinkat(dirfd) returned %ld", ret);
+	CHECK(strcmp(host_readlink(argv[1], "dirfd", "link-1"), "target-1") == 0, "link-1 is in the dirfd directory");
+	CHECK(host_readlink(argv[1], "wd", "link-1")[0] == 0, "link-1 is not in the working directory");
+
+	ret = sys_symlinkat("target-2", BSD_AT_FDCWD, "link-2");
+	CHECK(ret == 0 && strcmp(host_readlink(argv[1], "wd", "link-2"), "target-2") == 0,
+		"symlinkat(AT_FDCWD) creates link-2 in the working directory");
+	DONE();
+}
diff --git a/darling/tests/host/waitid.c b/darling/tests/host/waitid.c
new file mode 100644
index 00000000..13d5af6a
--- /dev/null
+++ b/darling/tests/host/waitid.c
@@ -0,0 +1,43 @@
+// Syscall 416 (waitid_nocancel, XNU syscalls.master) through __bsd_syscall_table, into waitid.c, on Linux.
+// Built with Darling's headers: siginfo_t and the W* options are Darwin's.
+#include <signal.h>
+#include <sys/wait.h>
+#include <errno.h>
+#include "check.h"
+
+extern void* __bsd_syscall_table[600];
+int host_spawn_gated(int* gate);
+void host_release(int gate);
+void* memset(void*, int, unsigned long);
+
+typedef long (*waitid_f)(int idtype, int id, siginfo_t* si, int options);
+
+int main(void)
+{
+	waitid_f nocancel = (waitid_f) __bsd_syscall_table[416], waitid = (waitid_f) __bsd_syscall_table[173];
+	siginfo_t si;
+	int gate;
+	long ret;
+
+	CHECK(waitid != 0, "syscall 173 (waitid) is in the table");
+	CHECK(nocancel != 0, "syscall 416 (waitid_nocancel) is in the table");
+	if (!nocancel)
+		DONE();
+
+	int child = host_spawn_gated(&gate);
+	memset(&si, 0x5a, sizeof(si));
+	ret = nocancel(P_PID, child, &si, WEXITED | WNOHANG | WNOWAIT);
+	CHECK(ret == 0 && si.si_pid == 0, "WNOHANG, child running: 0 and si_pid 0 (ret %ld si_pid %d)", ret, si.si_pid);
+
+	host_release(gate);
+	memset(&si, 0x5a, sizeof(si));
+	ret = nocancel(P_PID, child, &si, WEXITED | WNOWAIT);
+	CHECK(ret == 0 && si.si_pid == child && si.si_signo == SIGCHLD && si.si_code == CLD_EXITED && si.si_status == 42,
+		"WNOWAIT: pid %d signo %d code %d status %d", si.si_pid, si.si_signo, si.si_code, si.si_status);
+
+	ret = waitid(P_PID, child, &si, WEXITED);
+	CHECK(ret == 0 && si.si_pid == child && si.si_status == 42, "waitid (173) reaps it");
+	ret = nocancel(P_PID, child, &si, WEXITED | WNOHANG);
+	CHECK(ret == -ECHILD, "reaped: -ECHILD (%ld)", ret);
+	DONE();
+}
