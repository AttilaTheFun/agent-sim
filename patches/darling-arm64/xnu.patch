+	if (LINUX_SYSCALL(__NR_newfstatat, ldfd, lpath, &lst, FSGP_LINUX_AT_SYMLINK_NOFOLLOW) < 0)
+		return;
+	r->dev = (unsigned int) lst.st_dev;
+	r->ino = lst.st_ino;
