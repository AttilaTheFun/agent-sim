+
+// setpriority(PRIO_DARWIN_ROLE, pid, role): the task role RunningBoard gives an app (foreground, background, ...).
+void x86sim_jetsam_darwin_role(int pid, int role)
+{
+	struct js_state st;
+	if (pid <= 0)
+		pid = (int)sys_getpid();
