diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9ac2b8d..31aaa1a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,19 @@ mig(iokitdarling.defs)
 unset(MIG_NO_XTRACE)
 mig(powermanagement.defs)
 
+# x86Sim: every out-of-line reply buffer (io_registry_entry_get_properties*, ...) is a fresh vm_allocate()
+# here; the xnu defs say nothing about deallocating it because the kernel's copyout consumes it. As a user-space
+# server, iokitd has to send it with deallocate = TRUE or each reply leaks its pages (backboardd/SpringBoard/
+# UIKit ask for registry properties all the time: ~35-50 MB of anon in every phone's iokitd after a boot).
+add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/iokitmigServerDealloc.c
+	COMMAND sed "s/deallocate =  FALSE/deallocate = TRUE/"
+		${CMAKE_CURRENT_BINARY_DIR}/iokitmigServer.c > ${CMAKE_CURRENT_BINARY_DIR}/iokitmigServerDealloc.c
+	DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/iokitmigServer.c VERBATIM)
+add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/iokitmig32ServerDealloc.c
+	COMMAND sed "s/deallocate =  FALSE/deallocate = TRUE/"
+		${CMAKE_CURRENT_BINARY_DIR}/iokitmig32Server.c > ${CMAKE_CURRENT_BINARY_DIR}/iokitmig32ServerDealloc.c
+	DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/iokitmig32Server.c VERBATIM)
+
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -std=c++17")
 
 set(iokitd_sources
@@ -83,8 +96,8 @@ set(iokitd_sources
 	src/HostInputMonitor.mm
 	src/IOHostGPU.mm
 	src/IOHostBlockStorage.mm
-	${CMAKE_CURRENT_BINARY_DIR}/iokitmigServer.c
-	${CMAKE_CURRENT_BINARY_DIR}/iokitmig32Server.c
+	${CMAKE_CURRENT_BINARY_DIR}/iokitmigServerDealloc.c
+	${CMAKE_CURRENT_BINARY_DIR}/iokitmig32ServerDealloc.c
 	${CMAKE_CURRENT_BINARY_DIR}/iokitdarlingServer.c
 	src/iokitDispatch.cpp
 	src/IOAsyncCompletion.cpp
@@ -94,7 +107,7 @@ set(iokitd_sources
 )
 
 add_darling_executable(iokitd ${iokitd_sources})
-target_link_libraries(iokitd cxx bsm.0 CoreFoundation Foundation IOKit X11 XRandR Xext EGL GL IOSurface dbus)
+target_link_libraries(iokitd cxx bsm.0 CoreFoundation Foundation IOKit X11 XRandR Xext IOSurface dbus)
 
 install(TARGETS iokitd DESTINATION libexec/darling/usr/sbin)
 install(FILES org.darlinghq.iokitd.plist DESTINATION libexec/darling/System/Library/LaunchDaemons)
