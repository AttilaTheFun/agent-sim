-		std::cerr << "IOSurfaceRoot: eglInitialize failed, EGL error 0x" << std::hex << eglGetError() << std::dec << std::endl;
-		m_display = EGL_NO_DISPLAY;
-		return;
-	}
-
-	if (!eglChooseConfig(m_display, attribute_list, &config, 1, &num_config) || num_config < 1)
