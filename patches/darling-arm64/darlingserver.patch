+				fprintf(f, "t=%lld calls", (long long)sec);
+				for (int i = 0; i < 512; i++) { uint64_t c = x86sim_calls[i].exchange(0); if (c) fprintf(f, " %d:%llu", i, (unsigned long long)c); }
