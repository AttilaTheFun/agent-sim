+		int ok_ = kr_ == (expected); \
+		printf("%s %s: %d (want %d)\n", ok_ ? "PASS" : "FAIL", what, kr_, (int)(expected)); \
+		if (!ok_) fails++; \
+	} else { \
+		printf("FAIL %s: ABORT (dtape_stub_unsafe in %s: darlingserver would die)\n", what, aborted_in); \
+		fails++; aborts++; \
+	} \
