diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e08f7f..2700344 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -15,6 +15,9 @@ darling_xarch_flags(_sse_flags ARCHS ${_sse_archs} OPTIONS -msse -msse2 -msse3)
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${_sse_flags}")
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -w -nostdinc -fno-rtti -funwind-tables -ggdb -O0")
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -D__DARWIN_UNIX03 -fPIC -w")
+# x86Sim: clang 23 turns switch tables into relative lookup tables that the bundled ld64 cannot link (chained binds)
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fno-jump-tables")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fno-jump-tables")
 set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -nostdlib -Wl,-flat_namespace -Wl,-undefined,suppress")
 
 include_directories(${CMAKE_CURRENT_SOURCE_DIR}/libunwind/src)
