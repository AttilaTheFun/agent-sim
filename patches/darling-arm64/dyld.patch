+// True if `insn` reads the system counter: `mrs Xd, CNTVCT_EL0`, CNTVCTSS_EL0,
+// CNTPCT_EL0 or CNTPCTSS_EL0 (op0 3, op1 3, CRn 14, CRm 0, op2 2/6/1/5); stores d.
+static inline bool dyld_counter_is_read(uint32_t insn, uint32_t* reg)
+{
+    switch ( insn & 0xFFFFFFE0u ) {
+        case 0xD53BE040u: case 0xD53BE0C0u: case 0xD53BE020u: case 0xD53BE0A0u:
+            *reg = insn & 0x1F;
+            return true;
+        default:
+            return false;
+    }
+}
 
