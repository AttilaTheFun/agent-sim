+extern "C" unsigned long sys_thread_get_native_tsd_slot_offset(void);
+
+// The iOS simulator's shared cache reads the Darwin TSD base from TPIDRRO_EL0 (in libdyld's __tlv_get_addr: every
+// thread-local variable of every process, Darling's libsystem_kernel's included), which Linux keeps at 0. dyld_sim
+// maps the cache itself, through this helper, so each executable mapping of a cache file gets those reads rewritten
+// as dyld3 does for a private macOS cache (translateDarlingCacheTSD): a branch to a veneer that loads the base from
+// the native TLS slot libsystem_kernel fills, else the TSD trap. Only the reads are visited: their file offsets are
+// kept in the Darling prefix, /private/var/db/darling-sysregs/<cache name>-<size>-<mtime> (one hex offset per line),
+// written by the prefix's first process that maps the cache: not beside the cache, which may be on a read-only volume
+// shared by many phones.
+// System counter reads (JavaScriptCore, VFX) become the counter trap: Darling's mach_absolute_time counts
+// nanoseconds, not the 24 MHz counter (tsd_trap.h).
+// dyld cannot use snprintf (its libc's needs locale state): lowercase hex of `value`, no prefix; returns the length
+static int darlingHex(char* out, unsigned long long value)
+{
+	char digits[16];
+	int n = 0;
+	do { digits[n++] = "0123456789abcdef"[value & 15]; value >>= 4; } while ( value != 0 );
+	for (int i = 0; i < n; ++i)
+		out[i] = digits[n - 1 - i];
+	return n;
+}
+
+static void darlingSimCacheTSDSites(int fd, const char* cachePath, off_t fileOffset, size_t size,
+									const uint8_t* mapped, void (^site)(off_t))
+{
+	struct stat cacheStat;
+	if ( ::fstat(fd, &cacheStat) != 0 )
+		return;
+	const char* cacheName = strrchr(cachePath, '/');
+	cacheName = cacheName ? cacheName + 1 : cachePath;
+	char sitesPath[PATH_MAX];
+	strlcpy(sitesPath, "/private/var/db/darling-sysregs", sizeof(sitesPath));
+	::mkdir(sitesPath, 0755);
+	strlcat(sitesPath, "/", sizeof(sitesPath));
+	size_t n = strlcat(sitesPath, cacheName, sizeof(sitesPath));
+	if ( n + 2 * 17 >= sizeof(sitesPath) )
+		return;
+	sitesPath[n++] = '-';
+	n += darlingHex(sitesPath + n, (unsigned long long)cacheStat.st_size);
+	sitesPath[n++] = '-';
+	n += darlingHex(sitesPath + n, (unsigned long long)cacheStat.st_mtime);
+	sitesPath[n] = '\0';
+	int sfd = ::open(sitesPath, O_RDONLY | O_CLOEXEC);
+	if ( sfd >= 0 ) {
+		struct stat st;
+		if ( ::fstat(sfd, &st) == 0 && st.st_size > 0 && st.st_size < (1 << 20) ) {
+			char* text = (char*)::mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_PRIVATE, sfd, 0);
+			if ( text != MAP_FAILED ) {
+				const char* q = text;
+				const char* end = text + st.st_size;
+				while ( q < end ) {
+					off_t value = 0;
+					for (; q < end && *q != '\n'; ++q) {
+						char c = *q;
+						value = value * 16 + ((c >= '0' && c <= '9') ? c - '0' : (c | 0x20) - 'a' + 10);
+					}
+					++q;
+					if ( value >= fileOffset && value < fileOffset + (off_t)size )
+						site(value);
+				}
+				::munmap(text, (size_t)st.st_size);
+			}
+		}
+		::close(sfd);
+		return;
+	}
+	// No list yet: scan this mapping, and every executable mapping of the file for the list
+	struct stat cst;
+	if ( ::fstat(fd, &cst) != 0 )
+		return;
+	char header[0x400];
+	if ( ::pread(fd, header, sizeof(header), 0) != sizeof(header) )
+		return;
+	uint32_t mappingOffset = *(uint32_t*)(header + 16), mappingCount = *(uint32_t*)(header + 20);
+	if ( mappingCount > 16 || mappingOffset + 32 * mappingCount > sizeof(header) )
+		return;
+	char tmpPath[PATH_MAX + 24];
+	strlcpy(tmpPath, sitesPath, sizeof(tmpPath));
+	size_t tmpLength = strlen(tmpPath);
+	tmpPath[tmpLength++] = '.';
+	tmpPath[tmpLength + darlingHex(tmpPath + tmpLength, (unsigned long long)getpid())] = '\0';
+	int out = ::open(tmpPath, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+	for (uint32_t m = 0; m < mappingCount; ++m) {
+		const uint64_t* map = (const uint64_t*)(header + mappingOffset + 32 * m);
+		uint32_t initProt = *(const uint32_t*)(header + mappingOffset + 32 * m + 28);
+		if ( !(initProt & VM_PROT_EXECUTE) )
+			continue;
+		off_t start = (off_t)map[2];
+		size_t length = (size_t)map[1];
+		const uint32_t* words = (const uint32_t*)::mmap(NULL, length, PROT_READ, MAP_PRIVATE, fd, start);
+		if ( words == MAP_FAILED )
+			continue;
+		for (size_t i = 0; i < length / 4; ++i) {
+			uint32_t reg;
+			if ( !dyld_tsd_is_tpidrro_read(words[i], &reg) && !dyld_cpu_is_tpidr_read(words[i], &reg)
+				&& !dyld_counter_is_read(words[i], &reg) )
+				continue;
+			off_t at = start + (off_t)(4 * i);
+			if ( out >= 0 ) {
+				char line[24];
+				int n = darlingHex(line, (unsigned long long)at);
+				line[n++] = '\n';
+				(void)::write(out, line, n);
+			}
+			if ( at >= fileOffset && at < fileOffset + (off_t)size )
+				site(at);
+		}
+		::munmap((void*)words, length);
+	}
+	if ( out >= 0 ) {
+		::close(out);
+		if ( ::rename(tmpPath, sitesPath) != 0 )
+			::unlink(tmpPath);
+	}
+}
+
+static void darlingTranslateSimCacheTSD(void* mapped, size_t size, int prot, int fd, off_t fileOffset)
+{
+	char cachePath[PATH_MAX];
+	if ( ::fcntl(fd, F_GETPATH, cachePath) != 0 )
+		return;
+	unsigned long slot = sys_thread_get_native_tsd_slot_offset();
+	__block uint32_t* veneers = NULL;
+	__block size_t veneersUsed = 0;
+	const size_t veneersSize = 0x4000;
+	darlingSimCacheTSDSites(fd, cachePath, fileOffset, size, (const uint8_t*)mapped, ^(off_t at) {
+		uint32_t* insn = (uint32_t*)((uint8_t*)mapped + (at - fileOffset));
+		uint32_t reg, replacement;
+		void* page = (void*)((uintptr_t)insn & ~(uintptr_t)0x3fff);
+		if ( dyld_tsd_is_tpidrro_read(*insn, &reg) ) {
+			replacement = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_UDF_TSD_TRAP | reg);
+			if ( reg != 31 && dyld_tsd_slot_offset_valid(slot) ) {
+				if ( veneers == NULL ) {
+					// below the mapping, within a branch's reach (+-128 MiB) of its first 120 MiB
+					for (uintptr_t below = 0x100000; below <= 0x4000000 && veneers == NULL; below += 0x100000) {
+						void* want = (void*)(((uintptr_t)mapped - below) & ~(uintptr_t)0x3fff);
+						void* got = ::mmap(want, veneersSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+						if ( got == want )
+							veneers = (uint32_t*)got;
+						else if ( got != MAP_FAILED )
+							::munmap(got, veneersSize);
+					}
+				}
+				uint32_t entry;
+				uint32_t* code = veneers ? veneers + veneersUsed / 4 : NULL;
+				if ( code && veneersUsed + 4 * DYLD_TSD_VENEER_WORDS <= veneersSize
+					&& dyld_tsd_branch((uintptr_t)insn, (uintptr_t)code, &entry)
+					&& dyld_tsd_build_veneer(code, (uintptr_t)code, (uintptr_t)insn + 4, reg, slot) ) {
+					veneersUsed += 4 * DYLD_TSD_VENEER_WORDS;
+					replacement = entry;
+				}
+			}
+		} else if ( dyld_cpu_is_tpidr_read(*insn, &reg) ) {
+			replacement = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_MOVZ_X | reg);
+		} else if ( dyld_counter_is_read(*insn, &reg) ) {
+			replacement = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_UDF_COUNTER_TRAP | reg);
+		} else {
+			return;
+		}
+		if ( ::mprotect(page, 0x4000, PROT_READ | PROT_WRITE) != 0 )
+			return;
+		*insn = replacement;
+		sys_icache_invalidate(insn, 4);
+		::mprotect(page, 0x4000, prot);
+	});
+	if ( veneers != NULL ) {
+		sys_icache_invalidate(veneers, veneersUsed);
+		::mprotect(veneers, veneersSize, PROT_READ | PROT_EXEC);
+	}
+}
+
+// Whether the Mach-O whose header starts this mapping is built for a simulator (LC_BUILD_VERSION's platform: iOS,
+// tvOS, watchOS or visionOS simulator). Darling's host libraries are macOS images and keep their TPIDR_EL0 reads.
+static bool darlingIsSimulatorImage(const void* header, size_t size)
+{
+	const struct mach_header_64* mh = (const struct mach_header_64*)header;
+	if ( size < sizeof(*mh) || mh->magic != 0xFEEDFACFu || sizeof(*mh) + mh->sizeofcmds > size )
+		return false;
+	const struct load_command* cmd = (const struct load_command*)(mh + 1);
+	for (uint32_t i = 0; i < mh->ncmds; ++i) {
+		if ( cmd->cmd == LC_BUILD_VERSION ) {
+			uint32_t platform = ((const struct build_version_command*)cmd)->platform;
+			return platform == PLATFORM_IOSSIMULATOR || platform == PLATFORM_TVOSSIMULATOR
+				|| platform == PLATFORM_WATCHOSSIMULATOR || platform == 12 /* PLATFORM_XROS_SIMULATOR */;
+		}
+		cmd = (const struct load_command*)((const char*)cmd + cmd->cmdsize);
+	}
+	return false;
+}
+
+// An executable mapping of a Mach-O outside the cache: its TSD and counter reads become the traps (no sites file;
+// images are small next to the cache, and are scanned as they are mapped).
+static void darlingTranslateSimImageSysregs(void* mapped, size_t size, int prot)
+{
+	uint32_t* words = (uint32_t*)mapped;
+	bool changed = false;
+	for (size_t i = 0; i < size / 4; ++i) {
+		uint32_t reg, replacement;
+		if ( dyld_tsd_is_tpidrro_read(words[i], &reg) )
+			replacement = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_UDF_TSD_TRAP | reg);
+		else if ( dyld_cpu_is_tpidr_read(words[i], &reg) )
+			replacement = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_MOVZ_X | reg);
+		else if ( dyld_counter_is_read(words[i], &reg) )
+			replacement = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_UDF_COUNTER_TRAP | reg);
+		else
+			continue;
+		if ( !changed && ::mprotect(mapped, size, PROT_READ | PROT_WRITE) != 0 )
+			return;
+		changed = true;
+		words[i] = replacement;
+	}
+	if ( changed ) {
+		sys_icache_invalidate(mapped, size);
+		::mprotect(mapped, size, prot);
+	}
+}
+
+static void* darlingSimMmap(void* addr, size_t len, int prot, int flags, int fd, off_t offset)
+{
+	void* result = ::mmap(addr, len, prot, flags, fd, offset);
+	if ( result != MAP_FAILED && (prot & PROT_EXEC) && fd >= 0 && (flags & MAP_PRIVATE) ) {
+		char magic[8];
+		if ( ::pread(fd, magic, sizeof(magic), 0) == sizeof(magic) && memcmp(magic, "dyld_v1", 7) == 0 )
+			darlingTranslateSimCacheTSD(result, len, prot, fd, offset);
+		else if ( darlingIsSimulatorImage(result, len) )  // a simulator Mach-O's __TEXT (in a fat file too)
+			darlingTranslateSimImageSysregs(result, len, prot);
+	}
+	return result;
+}
