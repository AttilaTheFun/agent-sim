+#if __arm64__
+static void darlingApplyGuestEnvironment(const char* envp[])
+{
+	static const char prefix[] = "X86SIM_A64_GENV_";
+	const size_t prefixLen = sizeof(prefix) - 1;
+	for (int i = 0; envp[i] != NULL; ++i) {
+		if ( strncmp(envp[i], prefix, prefixLen) != 0 )
+			continue;
+		const char* assignment = envp[i] + prefixLen;  // "<NAME>=<value>"
+		const char* eq = strchr(assignment, '=');
+		if ( eq == NULL || eq == assignment )
+			continue;
+		size_t nameLen = (size_t)(eq - assignment) + 1;    // with the '='
+		bool replaced = false;
+		for (int j = 0; envp[j] != NULL; ++j) {
+			if ( j != i && strncmp(envp[j], assignment, nameLen) == 0 ) {
+				envp[j] = assignment;
+				replaced = true;
+			}
+		}
+		if ( !replaced )
+			envp[i] = assignment;
+	}
+}
+#endif
