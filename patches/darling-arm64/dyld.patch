+// dyld_sim, like a macOS arm64 cache (see translateDarlingCacheTSD), reads the Darwin TSD base from TPIDRRO_EL0,
+// which a Linux process cannot set, and the CPU number from TPIDR_EL0, the Linux thread pointer here. After its
+// private mapping each such read becomes the TSD trap libsystem_kernel emulates (tsd_trap.h) or CPU 0.
+static const char* darlingTranslateSimTSD(uintptr_t loadAddress, uintptr_t preferredLoadAddress,
+										  const struct load_command* cmds, uint32_t cmd_count)
+{
+	const struct load_command* cmd = cmds;
+	for (uint32_t i = 0; i < cmd_count; ++i) {
+		if ( cmd->cmd == LC_SEGMENT_COMMAND ) {
+			const struct macho_segment_command* seg = (struct macho_segment_command*)cmd;
+			if ( (seg->initprot & VM_PROT_EXECUTE) && seg->filesize != 0 ) {
+				void* start = (void*)(seg->vmaddr - preferredLoadAddress + loadAddress);
+				size_t size = (size_t)seg->filesize;
+				if ( ::mprotect(start, size, PROT_READ | PROT_WRITE) != 0 )
+					return "dyld_sim text could not be made writable for TSD translation";
+				bool changed = false;
+				for (uint32_t* insn = (uint32_t*)start; insn != (uint32_t*)start + size / 4; ++insn) {
+					uint32_t reg;
+					if ( dyld_tsd_is_tpidrro_read(*insn, &reg) )
+						*insn = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_UDF_TSD_TRAP | reg);
+					else if ( dyld_cpu_is_tpidr_read(*insn, &reg) )
+						*insn = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_MOVZ_X | reg);
+					else if ( dyld_counter_is_read(*insn, &reg) )
+						*insn = (reg == 31) ? DYLD_A64_NOP : (DYLD_A64_UDF_COUNTER_TRAP | reg);
+					else
+						continue;
+					changed = true;
+				}
+				if ( changed )
+					sys_icache_invalidate(start, size);
+				int protection = 0;
+				if ( seg->initprot & VM_PROT_READ )    protection |= PROT_READ;
+				if ( seg->initprot & VM_PROT_WRITE )   protection |= PROT_WRITE;
+				if ( seg->initprot & VM_PROT_EXECUTE ) protection |= PROT_EXEC;
+				if ( ::mprotect(start, size, protection) != 0 )
+					return "dyld_sim text protections could not be restored after TSD translation";
+			}
+		}
+		cmd = (const struct load_command*)(((char*)cmd)+cmd->cmdsize);
+	}
+	return NULL;
+}
