+# (a parameterized test's line says "Test f(n:) with 3 test cases passed": the test is f(n:))
+R_ST_END = re.compile(r"^\S+ Test (.+?)(?: with \d+ test cases?)? (passed|failed|skipped)(?: after (\d+(?:\.\d+)?) seconds)?")
+# Swift Testing's other lines (a test or test case started, a suite started or ended), which end a failure's message
+R_ST_OTHER = re.compile(r"^(\u25c7 |\S+ Suite |\S+ Test case )")
