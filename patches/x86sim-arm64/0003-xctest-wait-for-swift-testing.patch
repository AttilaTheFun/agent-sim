         m = R_ST_END.match(l)
         if m and m.group(1).startswith("run with "):   # Swift Testing's closing line ("Test run with N tests ...")
+            self.st_running = False
             return True
         if m and not l.startswith("Test "):
             t = self.test("SwiftTesting", m.group(1))
